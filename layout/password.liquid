<!doctype html>
{%- comment -%}
  Kofii Flow — Password layout
  ---------------------------------------------------------------------------
  Shopify renders the password page with this layout instead of theme.liquid.
  It is deliberately a stripped copy rather than a shared one: there is no
  header, no footer, no cart drawer and no navigation, because none of them
  lead anywhere while the shop is locked.

  The tokens, base and component stylesheets are still loaded, so the page uses
  the merchant's real typography and colors — a password page in a default
  serif is the first thing a visitor sees of the brand.

  `content_for_header` is required by Shopify on every layout, and
  `powered_by_link` is required specifically on this one.
{%- endcomment -%}
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  data-kf-flow="{{ settings.flow_mode }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    {%- for scheme in settings.color_schemes limit: 1 -%}
      <meta name="theme-color" content="{{ scheme.settings.background }}">
    {%- endfor -%}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>{{ page_title }} &ndash; {{ shop.name }}</title>

    {%- render 'kf-fonts' -%}

    {{ 'kf-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'kf-base.css' | asset_url | stylesheet_tag }}
    {{ 'kf-components.css' | asset_url | stylesheet_tag }}

    {%- render 'kf-css-variables' -%}

    {%- comment -%}
      The same boot script as the main layout, minus the motion engine — there
      is nothing on this page to animate, so `.kf-motion` is never added and
      no failsafe is needed.
    {%- endcomment -%}
    <script>
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('kf-js');
      })();
    </script>

    {{ content_for_header }}
  </head>

  <body class="kf-scheme kf-scheme--scheme-1 kf-password-layout">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    <footer class="kf-password-layout__footer">
      {{ powered_by_link }}
    </footer>
  </body>
</html>
