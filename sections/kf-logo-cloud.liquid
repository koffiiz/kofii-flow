      "info": "t:sections.kf-logo-cloud.settings.columns_desktop.info",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.kf-logo-cloud.settings.columns_mobile.label",
      "options": [
        {
          "value": "2",
          "label": "t:sections.kf-logo-cloud.settings.columns_mobile.options__1.label"
        },
        {
          "value": "3",
          "label": "t:sections.kf-logo-cloud.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:sections.kf-logo-cloud.settings.logo_height.label",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "t:sections.kf-logo-cloud.settings.show_dividers.label",
      "default": false,
      "info": "t:sections.kf-logo-cloud.settings.show_dividers.info"
    },
    {
      "type": "checkbox",
