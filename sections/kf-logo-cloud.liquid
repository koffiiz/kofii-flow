        },
        {
          "value": "fade-up",
          "label": "t:sections.kf-logo-cloud.settings.animation.options__3.label"
        },
        {
          "value": "scale-up",
          "label": "t:sections.kf-logo-cloud.settings.animation.options__4.label"
        },
        {
          "value": "blur-in",
          "label": "t:sections.kf-logo-cloud.settings.animation.options__5.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "checkbox",
      "id": "animation_stagger",
      "label": "t:sections.kf-logo-cloud.settings.animation_stagger.label",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_stagger_delay",
      "label": "t:sections.kf-logo-cloud.settings.animation_stagger_delay.label",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 60
    },
    {
      "type": "select",
      "id": "animation_duration",
      "label": "t:sections.kf-logo-cloud.settings.animation_duration.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.kf-logo-cloud.settings.animation_duration.options__1.label"
        },
        {
          "value": "fast",
          "label": "t:sections.kf-logo-cloud.settings.animation_duration.options__2.label"
