      "content": "t:sections.kf-logo-cloud.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kf-logo-cloud.settings.heading.label",
      "default": "As seen in"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.kf-logo-cloud.settings.heading_size.label",
      "options": [
        {
          "value": "kf-label",
          "label": "t:sections.kf-logo-cloud.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h5",
          "label": "t:sections.kf-logo-cloud.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h4",
          "label": "t:sections.kf-logo-cloud.settings.heading_size.options__3.label"
        },
        {
          "value": "kf-h3",
          "label": "t:sections.kf-logo-cloud.settings.heading_size.options__4.label"
        }
      ],
      "default": "kf-label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.kf-logo-cloud.settings.text.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-logo-cloud.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-logo-cloud.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-logo-cloud.settings.alignment.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.kf-logo-cloud.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.kf-logo-cloud.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.kf-logo-cloud.settings.layout.options__1.label"
