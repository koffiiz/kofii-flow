{%- comment -%}
  Kofii Flow — Logo cloud
  ---------------------------------------------------------------------------
  A wall of brand marks: "as seen in", "trusted by", stockists, certifications.

  Two layouts: a static grid, and a continuous scroll.

  The scroll is NOT a second marquee. It renders `snippets/kf-marquee-track.liquid`
  — the same viewport, tracks and pause button the marquee section uses, driven
  by the same <kf-marquee> element and the same CSS keyframes. All this section
  supplies is the items. The pause control WCAG 2.2 SC 2.2.2 requires, and the
  repeat logic that fills a wide viewport, come with it.

  Motion attributes are deliberately omitted from the items in the scrolling
  layout. <kf-marquee> clones the track's children to fill the viewport, and a
  clone carrying `data-kf-animate` would be claimed by the reveal engine but
  never observed — leaving it hidden for good.

  Height-led sizing, not width-led. Logos arrive at wildly different aspect
  ratios, and the only way a row of them looks deliberate is to fix the height
  and let each width fall out of it.

  Blocks are section-local. A logo is an image, a name and a link — not a
  content unit any other section would want.
{%- endcomment -%}

{{ 'section-logo-cloud.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The marquee's component CSS and element are requested only by the layout
  that needs them, so a static logo grid downloads neither.
{%- endcomment -%}
{%- if section.settings.layout == 'marquee' -%}
  {{ 'component-marquee.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'kf-marquee.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign s = section.settings

  assign is_marquee = false
  if s.layout == 'marquee'
    assign is_marquee = true
  endif

  assign root_class = 'kf-logos'
  assign root_class = root_class | append: ' kf-logos--' | append: s.layout
  assign root_class = root_class | append: ' kf-logos--' | append: s.logo_style
  assign root_class = root_class | append: ' kf-logos--align-' | append: s.alignment
  if s.show_dividers
    assign root_class = root_class | append: ' kf-logos--divided'
  endif

  comment
    Tablet sits between the two rather than carrying a setting of its own —
    with up to eight desktop columns a fixed tablet count would be wrong at
    both ends. Integer division, then clamped so it never drops below two.
  endcomment
  assign columns_tablet = s.columns_desktop | divided_by: 2
  if columns_tablet < 2
    assign columns_tablet = 2
  endif

  assign grid_style = '--kf-grid-cols: ' | append: s.columns_desktop
  assign grid_style = grid_style | append: '; --kf-grid-cols-tablet: ' | append: columns_tablet
  assign grid_style = grid_style | append: '; --kf-grid-cols-mobile: ' | append: s.columns_mobile | append: ';'

  comment
    A logo is small and rarely the widest thing on screen, so the srcset is
    capped well below the theme default rather than shipping a 1600px file
    to fill a 48px-tall slot.
  endcomment
  assign logo_sizes = '(min-width: 990px) 15vw, (min-width: 750px) 25vw, 40vw'
  assign logo_widths = '120,200,300,400,600'

  comment
    The shared keyframes always travel one way; `animation-direction` is what
    reverses them, so there is only ever one set of keyframes.
  endcomment
  assign scroll_direction = 'normal'
  if s.scroll_direction == 'right'
    assign scroll_direction = 'reverse'
  endif

  assign root_style = '--kf-logo-height: ' | append: s.logo_height | append: 'px'
  assign root_style = root_style | append: '; --kf-logo-rest: ' | append: s.logo_opacity | append: '%'
  assign root_style = root_style | append: '; --kf-marquee-duration: ' | append: s.scroll_speed | append: 's'
  assign root_style = root_style | append: '; --kf-marquee-direction: ' | append: scroll_direction
  assign root_style = root_style | append: '; --kf-marquee-gap: ' | append: s.scroll_gap | append: 'px;'
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: root_class, style: root_style %}>
  <div class="kf-container">
    {%- if s.heading != blank or s.text != blank -%}
      <header class="kf-logos__header" {% render 'kf-motion-attrs', motion: section.settings %}>
        {%- if s.heading != blank -%}
          <h2 class="kf-logos__heading {{ s.heading_size }}">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="kf-rte kf-text-muted kf-logos__text">{{ s.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%}
      One loop, both layouts. The wrapper element differs — list items in the
      grid, plain divs in the track, because <kf-marquee> clones the track's
      direct children and a nested list would be cloned whole — but the logo
      inside it is rendered once, in one place.
    {%- endcomment -%}
    {%- capture logo_items -%}
      {%- for block in section.blocks -%}
        {%- liquid
          comment
            The name is the logo's accessible name, so it is what a linked mark
            announces. The image's own alt text is the fallback for a merchant
            who set it on the asset instead.
          endcomment
          assign logo_alt = block.settings.name | default: block.settings.image.alt
        -%}
        {%- if is_marquee -%}
          <div class="kf-logos__item" {{ block.shopify_attributes }}>
        {%- else -%}
          <li
            class="kf-logos__item"
            {% render 'kf-motion-attrs',
              animation: s.animation,
              duration: s.animation_duration,
              easing: s.animation_easing %}
            {{ block.shopify_attributes }}
          >
        {%- endif -%}

        {%- if block.settings.link != blank -%}
          <a class="kf-logos__link" href="{{ block.settings.link }}">
        {%- endif -%}

        {%- render 'kf-media',
          image: block.settings.image,
          alt: logo_alt,
          ratio: 'adapt',
          fit: 'contain',
          flush: true,
          sizes: logo_sizes,
          widths: logo_widths,
          placeholder: 'image',
          class: 'kf-logos__media'
        -%}

        {%- if s.show_names and block.settings.name != blank -%}
          <span class="kf-text-xs kf-text-muted kf-logos__name">{{ block.settings.name | escape }}</span>
        {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}

        {%- if is_marquee -%}</div>{%- else -%}</li>{%- endif -%}
      {%- else -%}
        {%- comment -%}
          Nothing configured yet. Placeholder marks keep the section looking
          intentional in the Theme Editor instead of collapsing to a bare
          heading over empty space.
        {%- endcomment -%}
        {%- for i in (1..5) -%}
          {%- if is_marquee -%}
            <div class="kf-logos__item kf-logos__item--placeholder">
          {%- else -%}
            <li class="kf-logos__item kf-logos__item--placeholder">
          {%- endif -%}
          {%- render 'kf-media',
            ratio: 'adapt',
            fit: 'contain',
            flush: true,
            placeholder: 'image',
            class: 'kf-logos__media'
          -%}
          {%- if is_marquee -%}</div>{%- else -%}</li>{%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if is_marquee -%}
      {%- render 'kf-marquee-track',
        items: logo_items,
        pause_on_hover: s.pause_on_hover,
        edge_fade: s.edge_fade,
        class: 'kf-logos__marquee'
      -%}
    {%- else -%}
      <ul
        class="kf-grid kf-logos__grid"
        role="list"
        style="{{ grid_style }}"
        {% render 'kf-motion-attrs',
          stagger: s.animation_stagger,
          stagger_delay: s.animation_stagger_delay,
          trigger: s.animation_trigger %}
      >
        {{ logo_items }}
      </ul>
    {%- endif -%}
  </div>
</div>

