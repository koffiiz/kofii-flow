      "default": true
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "t:sections.kf-logo-cloud.settings.edge_fade.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.kf-logo-cloud.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "t:sections.kf-logo-cloud.settings.logo_style.label",
      "options": [
        {
          "value": "full-color",
          "label": "t:sections.kf-logo-cloud.settings.logo_style.options__1.label"
        },
        {
          "value": "monochrome",
          "label": "t:sections.kf-logo-cloud.settings.logo_style.options__2.label"
        }
      ],
      "default": "monochrome"
    },
