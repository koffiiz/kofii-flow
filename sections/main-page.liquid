{%- comment -%}
  Kofii Flow — Page content
  ---------------------------------------------------------------------------
  Renders a Shopify page. The page title is the single <h1> for this template.
  App blocks are supported so review widgets, forms and similar can be placed
  inside the page body.
{%- endcomment -%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-page' %}>
  <div class="kf-container{% if section.settings.width == 'narrow' %} kf-container--narrow{% endif %}">
    {%- if section.settings.show_title -%}
      <header class="kf-page__header kf-section-header{% if section.settings.alignment == 'center' %} kf-section-header--center{% endif %}">
        <h1 class="{{ section.settings.title_size }}" {% render 'kf-motion-attrs', motion: section.settings %}>
          {{- page.title | escape -}}
        </h1>
      </header>
    {%- endif -%}

    {%- if page.content != blank -%}
      <div class="kf-page__content kf-rte">
        {{ page.content }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="kf-page__blocks">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>{%- render block -%}</div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.kf-page__content {
  margin-top: var(--kf-space-md);
}

.kf-page__blocks {
  margin-top: var(--kf-space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--kf-space-md);
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "kf-page-section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.main-page.settings.show_title.label",
      "default": true
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "t:sections.main-page.settings.title_size.label",
      "options": [
        {
          "value": "kf-h2",
          "label": "t:sections.main-page.settings.title_size.options__1.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.main-page.settings.title_size.options__2.label"
        },
        {
          "value": "kf-display-sm",
          "label": "t:sections.main-page.settings.title_size.options__3.label"
        }
      ],
      "default": "kf-h1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.main-page.settings.width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.main-page.settings.width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-page.settings.width.options__2.label"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.main-page.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.main-page.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.main-page.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:sections.main-page.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.main-page.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-page.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.main-page.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.main-page.settings.animation.options__3.label"
        },
        {
          "value": "reveal",
          "label": "t:sections.main-page.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "animation_trigger",
      "label": "t:sections.main-page.settings.animation_trigger.label",
      "options": [
        {
          "value": "load",
          "label": "t:sections.main-page.settings.animation_trigger.options__1.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.main-page.settings.animation_trigger.options__2.label"
        }
      ],
      "default": "load"
    },
    {
      "type": "header",
      "content": "t:sections.main-page.settings.header__2.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-page.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main-page.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main-page.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
