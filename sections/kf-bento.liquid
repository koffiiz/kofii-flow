        },
        {
          "value": "spring",
          "label": "t:sections.kf-bento.settings.animation_easing.options__5.label"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "animation_trigger",
      "label": "t:sections.kf-bento.settings.animation_trigger.label",
      "options": [
        {
          "value": "scroll",
          "label": "t:sections.kf-bento.settings.animation_trigger.options__1.label"
        },
        {
