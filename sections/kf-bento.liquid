      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-bento.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-bento.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
