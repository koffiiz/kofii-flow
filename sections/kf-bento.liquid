          "label": "t:sections.kf-bento.settings.animation_trigger.options__2.label"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "t:sections.kf-bento.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-bento.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-bento.settings.section_transition.label",
      "info": "t:sections.kf-bento.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-bento.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-bento.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-bento.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-bento.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
