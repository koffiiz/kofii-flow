      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 60,
      "info": "t:sections.kf-bento.settings.animation_stagger_delay.info"
    },
    {
      "type": "select",
      "id": "animation_duration",
      "label": "t:sections.kf-bento.settings.animation_duration.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.kf-bento.settings.animation_duration.options__1.label"
        },
        {
          "value": "fast",
          "label": "t:sections.kf-bento.settings.animation_duration.options__2.label"
        },
        {
          "value": "normal",
          "label": "t:sections.kf-bento.settings.animation_duration.options__3.label"
        },
        {
          "value": "slow",
          "label": "t:sections.kf-bento.settings.animation_duration.options__4.label"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "label": "t:sections.kf-bento.settings.animation_easing.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.kf-bento.settings.animation_easing.options__1.label"
        },
        {
          "value": "standard",
          "label": "t:sections.kf-bento.settings.animation_easing.options__2.label"
        },
        {
