{%- comment -%}
  Kofii Flow — Bento grid
  ---------------------------------------------------------------------------
  A grid of tiles at mixed sizes. Each tile says how many columns and rows it
  spans and CSS grid places them in order.

  Three tile types, each reusing what the theme already has rather than
  restating it: an image tile through kf-media, a text tile through kf-button,
  and a product tile through the shared product card — so a product here looks
  identical to the same product in a collection grid.

  Mobile spans are computed HERE, not in CSS. A tile spanning four of six
  columns has to become "the whole row" on a two column grid, and clamping an
  integer span in CSS is not reliably supported. Liquid knows both numbers, so
  it does the arithmetic once and emits the answer.

  Blocks are section-local: a tile is a span plus a scrap of content, which
  means nothing outside this grid.
{%- endcomment -%}

{{ 'section-bento.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign has_header = false
  if s.heading != blank or s.eyebrow != blank or s.text != blank
    assign has_header = true
  endif

  assign grid_style = '--kf-bento-cols: ' | append: s.columns | append: ';'
  assign grid_style = grid_style | append: ' --kf-bento-row: ' | append: s.row_height | append: 'px;'
  assign grid_style = grid_style | append: ' --kf-bento-row-mobile: ' | append: s.row_height_mobile | append: 'px;'
  assign grid_style = grid_style | append: ' --kf-bento-gap: ' | append: s.gap | append: 'px;'
  assign grid_style = grid_style | append: ' --kf-bento-cols-mobile: ' | append: s.columns_mobile | append: ';'

  comment
    Stagger only means something when the tiles actually animate — the engine
    claims children that carry data-kf-animate, and with no animation there is
    nothing to sequence.
  endcomment
  assign use_stagger = false
  if s.animation != 'none'
    assign use_stagger = true
  endif
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-bento' %}>
  <div class="kf-container">
    {%- if has_header -%}
      <header class="kf-section-header kf-bento__header{% if s.alignment == 'center' %} kf-section-header--center{% endif %}">
        {%- if s.eyebrow != blank -%}
          <p class="kf-label kf-section-header__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="kf-section-header__text kf-rte">{{ s.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Stagger contract: the LIST carries data-kf-stagger, each TILE carries
        data-kf-animate. Giving the list an animation as well would animate the
        grid as one block and swallow the sequencing entirely.

        The grid's custom properties go THROUGH the snippet rather than beside
        it. kf-motion-attrs emits its own `style` attribute, and a second one
        on the same element is simply ignored by the parser — the column count
        and row height would vanish the moment an animation was chosen.
      {%- endcomment -%}
      <ul
        class="kf-bento__grid"
        role="list"
        {% render 'kf-motion-attrs',
          stagger: use_stagger,
          stagger_delay: s.animation_stagger_delay,
          trigger: s.animation_trigger,
          style: grid_style %}
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings

            comment
              A span wider than the grid would silently overflow the row, so it
              is clamped to the column count first.
            endcomment
            assign span_cols = b.column_span
            if span_cols > s.columns
              assign span_cols = s.columns
            endif

            comment
              On the mobile grid anything wider than one column becomes the
              full row. Two columns is too few for a middle ground.
            endcomment
            assign span_cols_mobile = 1
            if span_cols > 1
              assign span_cols_mobile = s.columns_mobile
            endif

            assign tile_class = 'kf-bento__tile kf-bento__tile--' | append: block.type
            assign tile_scheme = b.color_scheme
            if block.type != 'image' and tile_scheme.id != blank
              assign tile_class = tile_class | append: ' kf-scheme kf-scheme--' | append: tile_scheme.id
            endif

            assign tile_style = '--kf-tile-cols: ' | append: span_cols | append: ';'
            assign tile_style = tile_style | append: ' --kf-tile-rows: ' | append: b.row_span | append: ';'
            assign tile_style = tile_style | append: ' --kf-tile-cols-mobile: ' | append: span_cols_mobile | append: ';'
            if b.text_position == 'top'
              assign tile_style = tile_style | append: ' --kf-tile-justify: flex-start;'
            endif

            comment
              Image tiles are sized by their span, so the browser needs a hint
              of the rendered width rather than a guess of 100vw.
            endcomment
            assign tile_fraction = span_cols | times: 100 | divided_by: s.columns
            assign tile_sizes = '(min-width: 750px) ' | append: tile_fraction | append: 'vw, 100vw'
          -%}

          <li
            class="{{ tile_class }}"
            {% render 'kf-motion-attrs',
              animation: s.animation,
              duration: s.animation_duration,
              easing: s.animation_easing,
              style: tile_style %}
            {{ block.shopify_attributes }}
          >
            {%- case block.type -%}
              {%- when 'image' -%}
                <div class="kf-bento__media">
                  {%- render 'kf-media',
                    image: b.image,
                    ratio: 'square',
                    sizes: tile_sizes,
                    placeholder: 'lifestyle-1',
                    flush: true,
                    overlay_opacity: b.overlay_opacity,
                    overlay_style: b.overlay_style
                  -%}
                </div>

                {%- if b.heading != blank or b.text != blank -%}
                  <div class="kf-bento__overlay-text">
                    {%- if b.heading != blank -%}
                      <h3 class="{{ s.tile_heading_size }}">{{ b.heading }}</h3>
                    {%- endif -%}
                    {%- if b.text != blank -%}
                      <p class="kf-text-sm">{{ b.text | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if b.link != blank and b.link_label != blank -%}
                  <a class="kf-bento__cover" href="{{ b.link }}">{{ b.link_label | escape }}</a>
                {%- endif -%}

              {%- when 'product' -%}
                {%- if b.product != blank -%}
                  {%- render 'kf-product-card',
                    product: b.product,
                    heading_tag: 'h3',
                    sizes: tile_sizes
                  -%}
                {%- endif -%}

              {%- else -%}
                <div class="kf-bento__body">
                  {%- if b.eyebrow != blank -%}
                    <p class="kf-label">{{ b.eyebrow | escape }}</p>
                  {%- endif -%}
                  {%- if b.heading != blank -%}
                    <h3 class="{{ s.tile_heading_size }}">{{ b.heading }}</h3>
                  {%- endif -%}
                  {%- if b.text != blank -%}
                    <div class="kf-rte kf-text-sm kf-bento__text">{{ b.text }}</div>
                  {%- endif -%}
                  {%- if b.link_label != blank -%}
                    {%- render 'kf-button',
                      label: b.link_label,
                      href: b.link,
                      style: b.link_style,
                      icon: 'arrow'
                    -%}
                  {%- endif -%}
                </div>
            {%- endcase -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

