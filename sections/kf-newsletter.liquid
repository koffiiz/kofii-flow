{%- comment -%}
  Kofii Flow — Newsletter
  ---------------------------------------------------------------------------
  A signup band. The form itself is `snippets/kf-newsletter-form.liquid`, the
  same one the footer renders — Shopify's native customer form, so subscribers
  land in Customers tagged `newsletter` with no app involved, and the error and
  success states are already handled there.

  This section is the layout around it and nothing more. Nothing about the
  input, the button, the validation or the messages is re-implemented here.

  The form id is scoped to the section, because the footer's signup is on the
  same page on most stores and two forms sharing an id would break the
  label/input pairing for both.
{%- endcomment -%}

{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign newsletter_class = 'kf-newsletter-band kf-newsletter-band--' | append: s.layout
  if s.background_image != blank
    assign newsletter_class = newsletter_class | append: ' kf-newsletter-band--has-image'
  endif

  comment
    Filters are not allowed on render arguments, so the id is built first.
  endcomment
  assign form_id = 'Newsletter-' | append: section.id
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: newsletter_class %}>
  {%- if s.background_image != blank -%}
    <div class="kf-newsletter-band__backdrop" aria-hidden="true">
      {%- render 'kf-media',
        image: s.background_image,
        ratio: 'wide',
        sizes: '100vw',
        flush: true,
        overlay_opacity: s.overlay_opacity,
        overlay_style: s.overlay_style,
        class: 'kf-newsletter-band__media'
      -%}
    </div>
  {%- endif -%}

  <div class="kf-container">
    <div class="kf-newsletter-band__inner">
      <div class="kf-newsletter-band__text">
        {%- if s.eyebrow != blank -%}
          <p class="kf-label kf-section-header__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="kf-rte kf-newsletter-band__body">{{ s.text }}</div>
        {%- endif -%}
      </div>

      <div class="kf-newsletter-band__form">
        {%- render 'kf-newsletter-form', id: form_id -%}

        {%- if s.small_print != blank -%}
          <div class="kf-rte kf-text-sm kf-text-muted kf-newsletter-band__small-print">
            {{ s.small_print }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kf-newsletter.name",
  "tag": "section",
  "class": "kf-newsletter-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-newsletter.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kf-newsletter.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.kf-newsletter.settings.heading.label",
      "default": "Get the good stuff first"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.kf-newsletter.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h3",
          "label": "t:sections.kf-newsletter.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-newsletter.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.kf-newsletter.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.kf-newsletter.settings.text.label",
      "default": "<p>New arrivals, restocks and the occasional letter. No noise.</p>"
    },
    {
      "type": "richtext",
      "id": "small_print",
      "label": "t:sections.kf-newsletter.settings.small_print.label",
      "info": "t:sections.kf-newsletter.settings.small_print.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-newsletter.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.kf-newsletter.settings.layout.label",
      "options": [
        {
          "value": "center",
          "label": "t:sections.kf-newsletter.settings.layout.options__1.label"
        },
        {
          "value": "split",
          "label": "t:sections.kf-newsletter.settings.layout.options__2.label"
        }
      ],
      "default": "center",
      "info": "t:sections.kf-newsletter.settings.layout.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-newsletter.settings.header__3.content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.kf-newsletter.settings.background_image.label",
      "info": "t:sections.kf-newsletter.settings.background_image.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.kf-newsletter.settings.overlay_opacity.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:sections.kf-newsletter.settings.overlay_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:sections.kf-newsletter.settings.overlay_style.options__1.label"
        },
        {
          "value": "gradient",
          "label": "t:sections.kf-newsletter.settings.overlay_style.options__2.label"
        }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "t:sections.kf-newsletter.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-newsletter.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-newsletter.settings.section_transition.label",
      "info": "t:sections.kf-newsletter.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-newsletter.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-newsletter.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-newsletter.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-newsletter.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-newsletter.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-newsletter.presets.name"
    }
  ]
}
{% endschema %}
