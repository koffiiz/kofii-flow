{%- comment -%}
  Kofii Flow — Collections list
  ---------------------------------------------------------------------------
  The /collections index. A grid of collection cards, each one a single
  stretched link so screen readers announce one target per card — the same
  pattern the product card uses.

  Empty collections are skipped by default: a card that leads to nothing is
  worse than a shorter grid.
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign card_sizes = '(min-width: 990px) 33vw, (min-width: 768px) 50vw, 100vw'
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-collection-list' %}>
  <div class="kf-container">
    <header class="kf-section-header{% if s.alignment == 'center' %} kf-section-header--center{% endif %}">
      <h1 class="{{ s.heading_size }}">
        {%- if s.heading != blank -%}{{ s.heading | escape }}{%- else -%}{{ 'collections.all_title' | t }}{%- endif -%}
      </h1>
    </header>

    {%- paginate collections by s.per_page -%}
      {%- assign rendered = 0 -%}

      <ul
        class="kf-grid kf-collection-list__grid"
        role="list"
        style="--kf-grid-cols: {{ s.columns_desktop }}; --kf-grid-cols-tablet: 2; --kf-grid-cols-mobile: {{ s.columns_mobile }};"
        {% render 'kf-motion-attrs', motion: section.settings %}
      >
        {%- for collection in collections -%}
          {%- if collection.products_count > 0 or s.show_empty -%}
            {%- assign rendered = rendered | plus: 1 -%}
            <li class="kf-collection-card">
              {%- render 'kf-media',
                image: collection.featured_image,
                ratio: s.image_ratio,
                sizes: card_sizes,
                zoom: true,
                placeholder: 'collection-1',
                class: 'kf-collection-card__media'
              -%}

              <div class="kf-collection-card__body">
                <h2 class="kf-collection-card__title">
                  <a class="kf-card__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
                </h2>
                {%- if s.show_count -%}
                  <p class="kf-text-sm kf-text-muted">
                    {{ 'collections.product_count' | t: count: collection.products_count }}
                  </p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if rendered == 0 -%}
        <div class="kf-empty">
          <p class="kf-text-lg">{{ 'collections.none' | t }}</p>
        </div>
      {%- endif -%}

      {%- render 'kf-pagination', paginate: paginate, anchor: '#MainContent' -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "tag": "section",
  "class": "kf-collection-list-section",
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-list-collections.settings.heading.label",
      "info": "t:sections.main-list-collections.settings.heading.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.main-list-collections.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h2",
          "label": "t:sections.main-list-collections.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.main-list-collections.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-display-sm",
          "label": "t:sections.main-list-collections.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.main-list-collections.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.main-list-collections.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.main-list-collections.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:sections.main-list-collections.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.main-list-collections.settings.columns_desktop.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main-list-collections.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:sections.main-list-collections.settings.per_page.label",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.main-list-collections.settings.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__4.label"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main-list-collections.settings.show_count.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "t:sections.main-list-collections.settings.show_empty.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.main-list-collections.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.main-list-collections.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-list-collections.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.main-list-collections.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.main-list-collections.settings.animation.options__3.label"
        },
        {
          "value": "scale-up",
          "label": "t:sections.main-list-collections.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "animation_stagger",
      "label": "t:sections.main-list-collections.settings.animation_stagger.label",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_stagger_delay",
      "label": "t:sections.main-list-collections.settings.animation_stagger_delay.label",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 60
    },
    {
      "type": "header",
      "content": "t:sections.main-list-collections.settings.header__3.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-list-collections.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main-list-collections.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main-list-collections.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
