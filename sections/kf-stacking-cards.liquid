      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24,
      "info": "t:sections.kf-stacking-cards.settings.stack_step.info"
    },
    {
      "type": "range",
      "id": "stack_offset",
      "label": "t:sections.kf-stacking-cards.settings.stack_offset.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32,
      "info": "t:sections.kf-stacking-cards.settings.stack_offset.info"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "t:sections.kf-stacking-cards.settings.card_gap.label",
      "min": 40,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 160,
      "info": "t:sections.kf-stacking-cards.settings.card_gap.info"
    },
    {
      "type": "range",
      "id": "stack_end",
      "label": "t:sections.kf-stacking-cards.settings.stack_end.label",
      "min": 40,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 240,
      "info": "t:sections.kf-stacking-cards.settings.stack_end.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-stacking-cards.settings.header__4.content"
    },
