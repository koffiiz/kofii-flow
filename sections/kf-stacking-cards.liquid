      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-stacking-cards.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-stacking-cards.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "header_position",
      "label": "t:sections.kf-stacking-cards.settings.header_position.label",
      "options": [
        {
          "value": "side",
          "label": "t:sections.kf-stacking-cards.settings.header_position.options__1.label"
