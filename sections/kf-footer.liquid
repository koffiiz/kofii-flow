{%- comment -%}
  Kofii Flow — Footer
  ---------------------------------------------------------------------------
  Column blocks on top, a utility bar underneath. Every column type is a
  section block, so merchants add, remove and reorder columns without touching
  Liquid.

  No JavaScript of its own: the newsletter is a native Shopify customer form
  and the localization selectors use the shared auto-submit behaviour.
{%- endcomment -%}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-footer' %}>
  <div class="kf-container">
    {%- if section.blocks.size > 0 -%}
      <div class="kf-footer__columns" style="--kf-footer-columns: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <div class="kf-footer__column kf-footer__column--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  <div class="kf-footer__logo" style="--kf-footer-logo-width: {{ block.settings.logo_width }}px;">
                    {{
                      block.settings.logo
                      | image_url: width: 400
                      | image_tag:
                        class: 'kf-footer__logo-image',
                        loading: 'lazy',
                        widths: '100,160,200,260,320,400',
                        sizes: '200px',
                        alt: shop.name
                    }}
                  </div>
                {%- else -%}
                  <p class="kf-footer__brand-name">{{ shop.name }}</p>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="kf-rte kf-text-sm">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.show_social -%}
                  {%- render 'kf-social-icons', class: 'kf-footer__social' -%}
                {%- endif -%}

                {%- comment -%}
                  Follow on Shop. Shopify renders and styles the button itself
                  from the `login_button` filter — there is no theme markup to
                  wrap it in, and it is left alone deliberately.
                {%- endcomment -%}
                {%- if block.settings.show_follow_on_shop -%}
                  <div class="kf-footer__follow">
                    {{ shop | login_button: action: 'follow' }}
                  </div>
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="kf-label kf-footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="kf-footer__list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a class="kf-footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <p class="kf-muted kf-text-sm">{{ 'sections.footer.menu_empty' | t }}</p>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="kf-label kf-footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="kf-rte kf-text-sm">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="kf-label kf-footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="kf-rte kf-text-sm">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- render 'kf-newsletter-form', id: 'FooterNewsletter' -%}

              {%- when 'image' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="kf-label kf-footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                {%- render 'kf-media',
                  image: block.settings.image,
                  ratio: 'adapt',
                  sizes: '(min-width: 990px) 20vw, 60vw',
                  placeholder: 'image'
                -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}

            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="kf-footer__bar">
      <div class="kf-footer__bar-start">
        <p class="kf-footer__copy kf-text-sm">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
          {{ 'sections.footer.rights' | t }}
        </p>

        {%- if section.settings.show_policy_links -%}
          {%- if shop.policies.size > 0 -%}
            <ul class="kf-footer__policies">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a class="kf-footer__link" href="{{ policy.url }}">{{ policy.title }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="kf-footer__bar-end">
        {%- if section.settings.show_localization -%}
          {%- render 'kf-localization', id: 'Footer' -%}
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="kf-footer__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>
                {{ type | payment_type_svg_tag: class: 'kf-footer__payment-icon' }}
                <span class="kf-visually-hidden">{{ type }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kf-footer.name",
  "tag": "footer",
  "class": "kf-footer-section",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-footer.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "t:sections.kf-footer.settings.show_policy_links.label",
      "default": true,
      "info": "t:sections.kf-footer.settings.show_policy_links.info"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:sections.kf-footer.settings.show_localization.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.kf-footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.kf-footer.settings.header__2.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-footer.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-footer.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-footer.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.kf-footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.kf-footer.blocks.brand.settings.logo.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "t:sections.kf-footer.blocks.brand.settings.logo_width.label",
          "min": 60,
          "max": 260,
          "step": 10,
          "unit": "px",
          "default": 140
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.kf-footer.blocks.brand.settings.text.label",
          "default": "<p>Beautiful storefronts that flow.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "t:sections.kf-footer.blocks.brand.settings.show_social.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_follow_on_shop",
          "label": "t:sections.kf-footer.blocks.brand.settings.show_follow_on_shop.label",
          "default": true,
          "info": "t:sections.kf-footer.blocks.brand.settings.show_follow_on_shop.info"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.kf-footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.kf-footer.blocks.menu.settings.heading.label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.kf-footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.kf-footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.kf-footer.blocks.text.settings.heading.label",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.kf-footer.blocks.text.settings.text.label",
          "default": "<p>Tell people who you are in two short sentences.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.kf-footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.kf-footer.blocks.newsletter.settings.heading.label",
          "default": "Stay in flow"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.kf-footer.blocks.newsletter.settings.text.label",
          "default": "<p>New arrivals, quietly. No noise.</p>"
        },
        {
          "type": "paragraph",
          "content": "t:sections.kf-footer.blocks.newsletter.settings.paragraph__1.content"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.kf-footer.blocks.image.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.kf-footer.blocks.image.settings.heading.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.kf-footer.blocks.image.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.kf-footer.blocks.image.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-footer.presets.name",
      "blocks": [
        {
          "type": "brand"
        },
        {
          "type": "menu"
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
