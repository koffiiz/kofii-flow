{%- comment -%}
  Kofii Flow — Product recommendations
  ---------------------------------------------------------------------------
  Related or complementary products beneath the product page.

  This section renders TWICE, and the branch below decides which pass it is in:

    recommendations.performed == false
      The normal product page render. Shopify only fills the `recommendations`
      object for a request to the recommendations route, so there is nothing to
      show yet — only the empty <kf-product-recommendations> shell carrying the
      URL to fetch.

    recommendations.performed == true
      The fetch response. The element pulls [data-kf-recs-content] out of it and
      swaps it in.

  Nothing is rendered at all when there are no recommendations. No heading, no
  skeleton, no reserved height — a store that has not set complementary
  products up should show nothing rather than an empty titled band on every
  product page.

  The stylesheet and scripts sit OUTSIDE the branch on purpose. The element
  only lifts the content node out of the fetched document, so any asset tags in
  that response are discarded; they have to be requested on the first pass.

  `intent: related` is generated by Shopify automatically. `complementary`
  returns nothing until the merchant sets products up in Shopify's Search &
  Discovery app, which is why the setting says so.
{%- endcomment -%}

{{ 'section-product-recommendations.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-quick-add.css' | asset_url | stylesheet_tag }}
{{ 'component-quantity.css' | asset_url | stylesheet_tag }}
{{ 'component-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'component-buy-buttons.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kf-product-recommendations.js' | asset_url }}" defer></script>
<script src="{{ 'kf-quick-add.js' | asset_url }}" defer></script>
<script src="{{ 'kf-cart.js' | asset_url }}" defer></script>
<script src="{{ 'kf-variant-picker.js' | asset_url }}" defer></script>
<script src="{{ 'kf-product-form.js' | asset_url }}" defer></script>
<script src="{{ 'kf-quantity.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings

  assign recs_class = 'kf-recs'
  if s.mobile_layout == 'scroll'
    assign recs_class = recs_class | append: ' kf-recs--scroll-mobile'
  endif

  assign recs_style = '--kf-recs-cols: ' | append: s.columns_desktop | append: ';'
  assign recs_style = recs_style | append: ' --kf-recs-cols-tablet: ' | append: s.columns_tablet | append: ';'
  assign recs_style = recs_style | append: ' --kf-recs-cols-mobile: ' | append: s.columns_mobile | append: ';'

  assign card_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw'
-%}

{%- if recommendations.performed -%}
  {%- if recommendations.products_count > 0 -%}
    <div
      {% render 'kf-section-attrs', s: section.settings, extra_class: recs_class, style: recs_style %}
      data-kf-recs-content
    >
      <div class="kf-container">
        {%- if s.heading != blank -%}
          <header class="kf-section-header kf-recs__header{% if s.alignment == 'center' %} kf-section-header--center{% endif %}">
            <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
          </header>
        {%- endif -%}

        {%- comment -%}
          Stagger contract: the LIST carries data-kf-stagger, each ITEM carries
          data-kf-animate. Putting the animation on the list as well would
          animate the row as one block and swallow the sequencing.
        {%- endcomment -%}
        <ul
          class="kf-recs__list"
          role="list"
          {% render 'kf-motion-attrs', stagger: true, stagger_delay: s.animation_stagger_delay %}
        >
          {%- for product in recommendations.products -%}
            <li class="kf-recs__item" {% render 'kf-motion-attrs', animation: s.animation %}>
              {%- render 'kf-product-card',
                product: product,
                heading_tag: 'h3',
                sizes: card_sizes
              -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

{%- elsif product != blank -%}
  {%- comment -%}
    `section.id` rather than a literal name: in a JSON template the id is
    `template--<theme_id>__<name>`, and a hardcoded string would quietly
    return the wrong section — the same trap documented for the cart.
  {%- endcomment -%}
  {%- liquid
    comment
      Built by appending rather than captured across lines: `strip_newlines`
      drops the line breaks but leaves the indentation, which would put literal
      spaces inside the query string.
    endcomment
    assign recs_url = routes.product_recommendations_url
    assign recs_url = recs_url | append: '?section_id=' | append: section.id
    assign recs_url = recs_url | append: '&product_id=' | append: product.id
    assign recs_url = recs_url | append: '&limit=' | append: s.limit
    assign recs_url = recs_url | append: '&intent=' | append: s.intent
  -%}

  <kf-product-recommendations data-url="{{ recs_url | escape }}"></kf-product-recommendations>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.kf-product-recommendations.name",
  "tag": "section",
  "class": "kf-recs-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-product-recommendations.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.kf-product-recommendations.settings.intent.label",
      "options": [
        {
          "value": "related",
          "label": "t:sections.kf-product-recommendations.settings.intent.options__1.label"
        },
        {
          "value": "complementary",
          "label": "t:sections.kf-product-recommendations.settings.intent.options__2.label"
        }
      ],
      "default": "related",
      "info": "t:sections.kf-product-recommendations.settings.intent.info"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.kf-product-recommendations.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.kf-product-recommendations.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h4",
          "label": "t:sections.kf-product-recommendations.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h3",
          "label": "t:sections.kf-product-recommendations.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-product-recommendations.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h3"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-product-recommendations.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-product-recommendations.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-product-recommendations.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:sections.kf-product-recommendations.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.kf-product-recommendations.settings.limit.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "info": "t:sections.kf-product-recommendations.settings.limit.info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.kf-product-recommendations.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "t:sections.kf-product-recommendations.settings.columns_tablet.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.kf-product-recommendations.settings.mobile_layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.kf-product-recommendations.settings.mobile_layout.options__1.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.kf-product-recommendations.settings.mobile_layout.options__2.label"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.kf-product-recommendations.settings.columns_mobile.label",
      "info": "t:sections.kf-product-recommendations.settings.columns_mobile.info",
      "options": [
        {
          "value": "1",
          "label": "t:sections.kf-product-recommendations.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.kf-product-recommendations.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.kf-product-recommendations.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.kf-product-recommendations.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-product-recommendations.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.kf-product-recommendations.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.kf-product-recommendations.settings.animation.options__3.label"
        },
        {
          "value": "scale-up",
          "label": "t:sections.kf-product-recommendations.settings.animation.options__4.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "animation_stagger_delay",
      "label": "t:sections.kf-product-recommendations.settings.animation_stagger_delay.label",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 70
    },
    {
      "type": "header",
      "content": "t:sections.kf-product-recommendations.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-product-recommendations.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-product-recommendations.settings.section_transition.label",
      "info": "t:sections.kf-product-recommendations.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-product-recommendations.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-product-recommendations.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-product-recommendations.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-product-recommendations.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-product-recommendations.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-product-recommendations.presets.name"
    }
  ]
}
{% endschema %}
