{%- comment -%}
  Kofii Flow — Rich text
  ---------------------------------------------------------------------------
  A centred column of type: eyebrow, heading, paragraph, buttons. The section
  every store needs between two heavier ones.

  It owns no content of its own. Everything inside is theme blocks — the same
  heading, text, button, badge, image, divider and spacer blocks the hero uses
  — so anything added to /blocks becomes available here for free.

  The content column is a Kofii Motion stagger container: each block carries
  its own animation setting and this section sequences whichever ones opt in.
  No animation code lives here.

  No section stylesheet: these rules are a handful of layout modifiers that
  nothing else could reuse, so they stay inline.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign rich_class = 'kf-rich-text'
  assign rich_class = rich_class | append: ' kf-rich-text--w-' | append: s.content_width
  assign rich_class = rich_class | append: ' kf-rich-text--align-' | append: s.alignment
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: rich_class %}>
  <div class="kf-container">
    <div class="kf-rich-text__inner" {% render 'kf-motion-attrs', motion: section.settings %}>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
.kf-rich-text__inner {
  display: flex;
  flex-direction: column;
  gap: var(--kf-space-sm);
  min-width: 0;
}

.kf-rich-text--w-narrow .kf-rich-text__inner { max-width: var(--kf-narrow-width); }
.kf-rich-text--w-medium .kf-rich-text__inner { max-width: var(--kf-content-width); }
.kf-rich-text--w-wide .kf-rich-text__inner { max-width: 64rem; }
.kf-rich-text--w-full .kf-rich-text__inner { max-width: none; }

.kf-rich-text--align-center .kf-rich-text__inner {
  align-items: center;
  text-align: center;
  margin-inline: auto;
}

.kf-rich-text--align-end .kf-rich-text__inner {
  align-items: flex-end;
  text-align: right;
  margin-inline-start: auto;
}

/* Button groups and trust rows are flex containers of their own, so they need
   their own alignment rather than inheriting text-align. */
.kf-rich-text--align-center .kf-button-group,
.kf-rich-text--align-center .kf-trust {
  justify-content: center;
}

.kf-rich-text--align-end .kf-button-group,
.kf-rich-text--align-end .kf-trust {
  justify-content: flex-end;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.kf-rich-text.name",
  "tag": "section",
  "class": "kf-rich-text-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-rich-text.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.kf-rich-text.settings.content_width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.kf-rich-text.settings.content_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.kf-rich-text.settings.content_width.options__2.label"
        },
        {
          "value": "wide",
          "label": "t:sections.kf-rich-text.settings.content_width.options__3.label"
        },
        {
          "value": "full",
          "label": "t:sections.kf-rich-text.settings.content_width.options__4.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-rich-text.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-rich-text.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-rich-text.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.kf-rich-text.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.kf-rich-text.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.kf-rich-text.settings.paragraph__3.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.kf-rich-text.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-rich-text.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.kf-rich-text.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.kf-rich-text.settings.animation.options__3.label"
        },
        {
          "value": "blur-in",
          "label": "t:sections.kf-rich-text.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "animation_stagger",
      "label": "t:sections.kf-rich-text.settings.animation_stagger.label",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_stagger_delay",
      "label": "t:sections.kf-rich-text.settings.animation_stagger_delay.label",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 90
    },
    {
      "type": "select",
      "id": "animation_duration",
      "label": "t:sections.kf-rich-text.settings.animation_duration.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.kf-rich-text.settings.animation_duration.options__1.label"
        },
        {
          "value": "fast",
          "label": "t:sections.kf-rich-text.settings.animation_duration.options__2.label"
        },
        {
          "value": "normal",
          "label": "t:sections.kf-rich-text.settings.animation_duration.options__3.label"
        },
        {
          "value": "slow",
          "label": "t:sections.kf-rich-text.settings.animation_duration.options__4.label"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "label": "t:sections.kf-rich-text.settings.animation_easing.label",
      "options": [
        {
          "value": "theme",
          "label": "t:sections.kf-rich-text.settings.animation_easing.options__1.label"
        },
        {
          "value": "standard",
          "label": "t:sections.kf-rich-text.settings.animation_easing.options__2.label"
        },
        {
          "value": "smooth",
          "label": "t:sections.kf-rich-text.settings.animation_easing.options__3.label"
        },
        {
          "value": "out",
          "label": "t:sections.kf-rich-text.settings.animation_easing.options__4.label"
        },
        {
          "value": "spring",
          "label": "t:sections.kf-rich-text.settings.animation_easing.options__5.label"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "animation_trigger",
      "label": "t:sections.kf-rich-text.settings.animation_trigger.label",
      "options": [
        {
          "value": "scroll",
          "label": "t:sections.kf-rich-text.settings.animation_trigger.options__1.label"
        },
        {
          "value": "load",
          "label": "t:sections.kf-rich-text.settings.animation_trigger.options__2.label"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "t:sections.kf-rich-text.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-rich-text.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-rich-text.settings.section_transition.label",
      "info": "t:sections.kf-rich-text.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-rich-text.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-rich-text.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-rich-text.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-rich-text.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-rich-text.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-rich-text.presets.name",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "text": "Our promise",
            "style": "outline",
            "animation": "fade-up"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Made to be kept, not replaced",
            "heading_size": "kf-h2",
            "heading_tag": "h2",
            "animation": "fade-up"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Two or three sentences on what you stand for. Say the thing a shopper cannot find on any other store, and stop there.</p>",
            "text_size": "lg",
            "animation": "fade-up"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Read our story",
            "style": "secondary",
            "animation": "fade-up"
          }
        }
      ]
    }
  ]
}
{% endschema %}
