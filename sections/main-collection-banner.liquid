{%- comment -%}
  Kofii Flow — Collection banner
  ---------------------------------------------------------------------------
  The collection heading, description and optional image. Separate from the
  product grid so a merchant can remove it, reorder it, or put marketing
  sections between it and the products.

  The collection title is the page <h1>.
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign has_image = false
  if s.show_image and collection.image
    assign has_image = true
  endif

  assign banner_class = 'kf-collection-banner kf-collection-banner--' | append: s.layout
  if has_image
    assign banner_class = banner_class | append: ' kf-collection-banner--has-image'
  endif
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: banner_class %}>
  {%- if has_image and s.layout == 'overlay' -%}
    <div class="kf-collection-banner__backdrop">
      {%- render 'kf-media',
        image: collection.image,
        ratio: 'wide',
        sizes: '100vw',
        loading: 'eager',
        priority: true,
        flush: true,
        class: 'kf-collection-banner__media'
      -%}
      {%- if s.overlay_opacity > 0 -%}
        <div
          class="kf-media__overlay kf-media__overlay--gradient"
          style="--kf-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};"
        ></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="kf-container kf-collection-banner__inner">
    <div class="kf-collection-banner__content" {% render 'kf-motion-attrs', motion: section.settings %}>
      {%- if s.show_breadcrumb -%}
        <nav class="kf-breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
          <ol class="kf-breadcrumb__list" role="list">
            <li><a class="kf-link" href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
            <li aria-current="page">{{ collection.title | escape }}</li>
          </ol>
        </nav>
      {%- endif -%}

      <h1 class="{{ s.heading_size }}">{{ collection.title | escape }}</h1>

      {%- if s.show_description and collection.description != blank -%}
        <div class="kf-collection-banner__description kf-rte kf-text-muted">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if has_image and s.layout == 'split' -%}
      <div class="kf-collection-banner__figure">
        {%- render 'kf-media',
          image: collection.image,
          ratio: 'landscape',
          sizes: '(min-width: 990px) 40vw, 100vw',
          loading: 'eager',
          priority: true
        -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "tag": "section",
  "class": "kf-collection-banner-section",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.main-collection-banner.settings.layout.label",
      "options": [
        {
          "value": "simple",
          "label": "t:sections.main-collection-banner.settings.layout.options__1.label"
        },
        {
          "value": "split",
          "label": "t:sections.main-collection-banner.settings.layout.options__2.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.main-collection-banner.settings.layout.options__3.label"
        }
      ],
      "default": "simple"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.main-collection-banner.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h2",
          "label": "t:sections.main-collection-banner.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.main-collection-banner.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-display-sm",
          "label": "t:sections.main-collection-banner.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h1"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main-collection-banner.settings.show_description.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main-collection-banner.settings.show_image.label",
      "default": true,
      "info": "t:sections.main-collection-banner.settings.show_image.info"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.main-collection-banner.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.main-collection-banner.settings.overlay_opacity.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "t:sections.main-collection-banner.settings.overlay_opacity.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-banner.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.main-collection-banner.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-banner.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.main-collection-banner.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.main-collection-banner.settings.animation.options__3.label"
        },
        {
          "value": "reveal",
          "label": "t:sections.main-collection-banner.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "animation_trigger",
      "label": "t:sections.main-collection-banner.settings.animation_trigger.label",
      "options": [
        {
          "value": "load",
          "label": "t:sections.main-collection-banner.settings.animation_trigger.options__1.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.main-collection-banner.settings.animation_trigger.options__2.label"
        }
      ],
      "default": "load"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-banner.settings.header__2.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-collection-banner.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main-collection-banner.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main-collection-banner.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}
