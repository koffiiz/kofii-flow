{%- comment -%}
  Kofii Flow — Password
  ---------------------------------------------------------------------------
  The page a visitor sees while the shop is password protected.

  Two things happen here: a newsletter signup, which is the whole point of a
  coming-soon page, and the password form itself for the merchant and anyone
  they have shared it with.

  The password form sits in a native <details>. It is the secondary action —
  most visitors are here to be told when the shop opens, not to unlock it — but
  it must open on its own whenever the password was wrong, or the visitor is
  returned to a page with the error hidden inside a closed disclosure.

  `form.errors` on `storefront_password` is a bare boolean, so the message is
  the theme's own string rather than `default_errors`.
{%- endcomment -%}

{{ 'section-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign page_title = s.heading
  if page_title == blank
    assign page_title = 'password.title' | t
  endif

  assign form_title = 'password.form_title' | t
  assign password_label = 'password.password_label' | t
  assign submit_label = 'password.submit' | t
  assign error_message = 'password.error' | t
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-password' %}>
  <div class="kf-container">
    <div class="kf-password__inner">
      {%- if s.logo != blank -%}
        <div class="kf-password__logo" style="--kf-password-logo: {{ s.logo_width }}px;">
          {%- render 'kf-media', image: s.logo, ratio: 'adapt', sizes: '200px', flush: true -%}
        </div>
      {%- else -%}
        <p class="kf-password__shop kf-h5">{{ shop.name }}</p>
      {%- endif -%}

      <h1 class="kf-password__title {{ s.heading_size }}">{{ page_title }}</h1>

      {%- comment -%}
        `shop.password_message` is what the merchant typed in Online Store →
        Preferences. It is not a theme setting and it must be shown, so it is
        rendered unconditionally above the section's own copy rather than being
        offered as an alternative to it.
      {%- endcomment -%}
      {%- if shop.password_message != blank -%}
        <div class="kf-rte kf-password__text">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- if s.text != blank -%}
        <div class="kf-rte kf-password__text">{{ s.text }}</div>
      {%- endif -%}

      {%- if s.show_newsletter -%}
        {%- assign newsletter_id = 'PasswordNewsletter' -%}
        <div class="kf-password__newsletter">
          {%- render 'kf-newsletter-form', id: newsletter_id -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        `form.errors` is only reachable inside the form, so the disclosure's
        open state is driven by Shopify's own `form.errors` via the wrapper
        below — the form tag has to come first for that to work.
      {%- endcomment -%}
      {%- form 'storefront_password' -%}
        <details class="kf-password__unlock" {% if form.errors %}open{% endif %}>
          <summary class="kf-password__unlock-summary">{{ form_title }}</summary>

          <div class="kf-password__unlock-body">
            {%- if form.errors -%}
              <p class="kf-form-message kf-form-message--error" role="alert">
                {%- render 'kf-icon', name: 'close', size: 'sm' -%}
                {{ error_message }}
              </p>
            {%- endif -%}

            <div class="kf-field">
              <label class="kf-field__label" for="PasswordInput">{{ password_label }}</label>
              <input
                class="kf-input"
                type="password"
                id="PasswordInput"
                name="password"
                autocomplete="current-password"
                required
              >
            </div>

            {%- render 'kf-button', label: submit_label, type: 'submit', style: 'primary' -%}
          </div>
        </details>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "tag": "section",
  "class": "kf-password-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main-password.settings.logo.label",
      "info": "t:sections.main-password.settings.logo.info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.main-password.settings.logo_width.label",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.main-password.settings.heading.label",
      "info": "t:sections.main-password.settings.heading.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.main-password.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h2",
          "label": "t:sections.main-password.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.main-password.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-display",
          "label": "t:sections.main-password.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.main-password.settings.text.label",
      "default": "<p>Something worth waiting for. Leave your email and we will let you know the moment we open.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main-password.settings.show_newsletter.label",
      "default": true,
      "info": "t:sections.main-password.settings.show_newsletter.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-password.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main-password.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main-password.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
