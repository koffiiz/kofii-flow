{%- comment -%}
  Kofii Flow — FAQ
  ---------------------------------------------------------------------------
  Questions and answers on native <details>, so they open and close with no
  JavaScript at all. <kf-accordion> only adds the height animation and the
  optional one-at-a-time behaviour on top.

  Blocks are SECTION-LOCAL, not the existing accordion theme block, and that is
  the whole reason this section exists rather than being an accordion dropped
  into a rich text section: `{% content_for 'blocks' %}` cannot be introspected,
  so a theme block's contents are unreachable from Liquid. The FAQPage graph
  below has to read every question and answer, which means the section has to
  own them.

  The question sits inside <summary> as a real heading. A <summary> may contain
  one heading element, and on a page of twenty questions that is the difference
  between a screen reader user being able to jump between them and having to
  walk the whole list.
{%- endcomment -%}

{{ 'section-faq.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kf-accordion.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings

  assign faq_class = 'kf-faq kf-faq--' | append: s.layout

  assign has_header = false
  if s.heading != blank or s.eyebrow != blank or s.text != blank
    assign has_header = true
  endif

  comment
    Only rows with both a question and an answer are rendered, and the same
    test gates the structured data — a graph describing an empty answer is
    worse than no graph.
  endcomment
  assign answered = 0
  for block in section.blocks
    assign answer_body = block.settings.answer
    if block.settings.page != blank
      assign answer_body = block.settings.page.content
    endif
    if block.settings.question != blank and answer_body != blank
      assign answered = answered | plus: 1
    endif
  endfor
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: faq_class %}>
  <div class="kf-container">
    <div class="kf-faq__inner">
      {%- if has_header -%}
        <header class="kf-section-header kf-faq__header{% if s.alignment == 'center' %} kf-section-header--center{% endif %}">
          {%- if s.eyebrow != blank -%}
            <p class="kf-label kf-section-header__eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.text != blank -%}
            <div class="kf-section-header__text kf-rte">{{ s.text }}</div>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if answered > 0 -%}
        <kf-accordion class="kf-faq__list" data-single="{{ s.single }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign answer_body = block.settings.answer
              if block.settings.page != blank
                assign answer_body = block.settings.page.content
              endif
            -%}
            {%- if block.settings.question != blank and answer_body != blank -%}
              <details
                class="kf-accordion__item kf-faq__item"
                {% if s.open_first and forloop.first %}open{% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="kf-accordion__summary">
                  <h3 class="kf-faq__question {{ s.question_size }}">{{ block.settings.question | escape }}</h3>
                  {%- render 'kf-icon', name: 'chevron', class: 'kf-accordion__icon', size: 'sm' -%}
                </summary>

                <div class="kf-accordion__panel">
                  <div class="kf-accordion__panel-inner kf-rte">
                    {{ answer_body }}
                  </div>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </kf-accordion>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  FAQPage structured data. Emitted last so it never sits between the visible
  rows, and only when there is something to describe.

  Answers keep their HTML rather than being stripped: schema.org accepts a
  limited set of tags inside acceptedAnswer, and a stripped answer loses its
  lists and links for no benefit. `| json` handles the escaping.
{%- endcomment -%}
{%- if s.show_schema and answered > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign printed = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign answer_body = block.settings.answer
            if block.settings.page != blank
              assign answer_body = block.settings.page.content
            endif
          -%}
          {%- if block.settings.question != blank and answer_body != blank -%}
            {%- if printed > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ answer_body | strip_newlines | json }}
              }
            }
            {%- assign printed = printed | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.kf-faq.name",
  "tag": "section",
  "class": "kf-faq-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-faq.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kf-faq.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.kf-faq.settings.heading.label",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.kf-faq.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h3",
          "label": "t:sections.kf-faq.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-faq.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.kf-faq.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.kf-faq.settings.text.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-faq.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-faq.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-faq.settings.alignment.options__2.label"
        }
      ],
      "default": "start",
      "info": "t:sections.kf-faq.settings.alignment.info"
    },
    {
      "type": "select",
      "id": "question_size",
      "label": "t:sections.kf-faq.settings.question_size.label",
      "options": [
        {
          "value": "kf-h6",
          "label": "t:sections.kf-faq.settings.question_size.options__1.label"
        },
        {
          "value": "kf-h5",
          "label": "t:sections.kf-faq.settings.question_size.options__2.label"
        },
        {
          "value": "kf-h4",
          "label": "t:sections.kf-faq.settings.question_size.options__3.label"
        }
      ],
      "default": "kf-h5"
    },
    {
      "type": "header",
      "content": "t:sections.kf-faq.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.kf-faq.settings.layout.label",
      "options": [
        {
          "value": "stacked",
          "label": "t:sections.kf-faq.settings.layout.options__1.label"
        },
        {
          "value": "side",
          "label": "t:sections.kf-faq.settings.layout.options__2.label"
        }
      ],
      "default": "stacked",
      "info": "t:sections.kf-faq.settings.layout.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-faq.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "single",
      "label": "t:sections.kf-faq.settings.single.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.kf-faq.settings.open_first.label",
      "default": false,
      "info": "t:sections.kf-faq.settings.open_first.info"
    },
    {
      "type": "checkbox",
      "id": "show_schema",
      "label": "t:sections.kf-faq.settings.show_schema.label",
      "default": true,
      "info": "t:sections.kf-faq.settings.show_schema.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-faq.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-faq.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-faq.settings.section_transition.label",
      "info": "t:sections.kf-faq.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-faq.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-faq.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-faq.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-faq.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-faq.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.kf-faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.kf-faq.blocks.question.settings.question.label",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.kf-faq.blocks.question.settings.answer.label",
          "default": "<p>Answer the question plainly, in a sentence or two.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.kf-faq.blocks.question.settings.page.label",
          "info": "t:sections.kf-faq.blocks.question.settings.page.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-faq.presets.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your returns policy?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
