{%- comment -%}
  Kofii Flow — Contact form
  ---------------------------------------------------------------------------
  Shopify's `{% form 'contact' %}`. Delivery, spam handling and the redirect
  back with `?contact_posted=true` are all the platform's; this section only
  renders the fields.

  On success the form is replaced by the confirmation rather than sitting above
  it. A shopper who has just submitted has nothing left to do here, and leaving
  a filled-looking form on screen reads as "it did not send".

  The confirmation is `role="status"` with `tabindex="-1"`: it is announced
  where it appears, and it is reachable by keyboard once the page returns.
{%- endcomment -%}

{{ 'section-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign name_label = 'contact.name' | t
  assign email_label = 'contact.email' | t
  assign phone_label = 'contact.phone' | t
  assign message_label = 'contact.message' | t
  assign send_label = 'contact.send' | t
  assign success_message = 'contact.post_success' | t
  assign errors_title = 'contact.errors_title' | t

  assign wrapper_class = 'kf-contact'
  if s.alignment == 'start'
    assign wrapper_class = wrapper_class | append: ' kf-contact--start'
  endif

  assign form_class = 'kf-contact__form'
  if s.button_full
    assign form_class = form_class | append: ' kf-contact__form--full'
  endif

  assign form_id = 'ContactForm-' | append: section.id
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-contact-section' %}>
  <div class="kf-container">
    <div class="{{ wrapper_class }}" {% render 'kf-motion-attrs', motion: s %}>
      {%- if s.heading != blank or s.text != blank -%}
        <header class="kf-contact__header">
          {%- if s.heading != blank -%}
            <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.text != blank -%}
            <div class="kf-rte kf-text-muted">{{ s.text }}</div>
          {%- endif -%}
        </header> 
      {%- endif -%}

      {%- form 'contact', id: form_id, class: form_class -%}
        {%- if form.posted_successfully? -%}
          <p
            class="kf-form-message kf-form-message--success kf-contact__success"
            role="status"
            tabindex="-1"
          >
            {%- render 'kf-icon', name: 'check', size: 'sm' -%}
            {{ success_message }}
          </p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="kf-form-message kf-form-message--error" role="alert">
              {%- render 'kf-icon', name: 'close', size: 'sm' -%}
              <div>
                <p>{{ errors_title }}</p>
                {{ form.errors | default_errors }}
              </div>
            </div>
          {%- endif -%}

          <div class="kf-contact__row">
            <div class="kf-field">
              <label class="kf-field__label" for="{{ form_id }}-name">{{ name_label }}</label>
              <input
                class="kf-input"
                type="text"
                id="{{ form_id }}-name"
                name="contact[name]"
                value="{{ form.name }}"
                autocomplete="name"
              >
            </div>

            <div class="kf-field">
              <label class="kf-field__label" for="{{ form_id }}-email">{{ email_label }}</label>
              <input
                class="kf-input"
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                value="{{ form.email }}"
                autocomplete="email"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                required
              >
            </div>
          </div>

          {%- if s.show_phone -%}
            <div class="kf-field">
              <label class="kf-field__label" for="{{ form_id }}-phone">{{ phone_label }}</label>
              <input
                class="kf-input"
                type="tel"
                id="{{ form_id }}-phone"
                name="contact[phone]"
                value="{{ form.phone }}"
                autocomplete="tel"
              >
            </div>
          {%- endif -%}

          <div class="kf-field">
            <label class="kf-field__label" for="{{ form_id }}-body">{{ message_label }}</label>
            <textarea
              class="kf-textarea"
              id="{{ form_id }}-body"
              name="contact[body]"
              rows="{{ s.message_rows }}"
              required
            >{{ form.body }}</textarea>
          </div>

          {%- render 'kf-button',
            label: send_label,
            type: 'submit',
            style: 'primary',
            full: s.button_full
          -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kf-contact-form.name",
  "tag": "section",
  "class": "kf-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kf-contact-form.settings.heading.label",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.kf-contact-form.settings.text.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.kf-contact-form.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h4",
          "label": "t:sections.kf-contact-form.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h3",
          "label": "t:sections.kf-contact-form.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-contact-form.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h3"
    },
    {
      "type": "header",
      "content": "t:sections.kf-contact-form.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-contact-form.settings.alignment.label",
      "options": [
        {
          "value": "center",
          "label": "t:sections.kf-contact-form.settings.alignment.options__1.label"
        },
        {
          "value": "start",
          "label": "t:sections.kf-contact-form.settings.alignment.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "t:sections.kf-contact-form.settings.show_phone.label",
      "default": true
    },
    {
      "type": "range",
      "id": "message_rows",
      "label": "t:sections.kf-contact-form.settings.message_rows.label",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "button_full",
      "label": "t:sections.kf-contact-form.settings.button_full.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.kf-contact-form.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.kf-contact-form.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-contact-form.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.kf-contact-form.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.kf-contact-form.settings.animation.options__3.label"
        },
        {
          "value": "blur-in",
          "label": "t:sections.kf-contact-form.settings.animation.options__4.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:sections.kf-contact-form.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.kf-contact-form.settings.header__3.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-contact-form.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-contact-form.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-contact-form.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-contact-form.presets.name"
    }
  ]
}
{% endschema %}
