      "label": "t:sections.kf-video.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-video.presets.name"
    }
  ]
}
{% endschema %}
