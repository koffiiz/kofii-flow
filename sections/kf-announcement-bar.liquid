{%- comment -%}
  Kofii Flow — Announcement bar
  ---------------------------------------------------------------------------
  One message renders statically and centered. Two or more scroll as a
  marquee, using the shared keyframes in kf-motion.css — the track is
  duplicated in markup so the loop is seamless with no JavaScript at all.

  The scrolling case is wrapped in <kf-marquee>, which adds the pause control
  WCAG 2.2 SC 2.2.2 requires for motion that starts on its own and runs past
  five seconds. Pause-on-hover alone does not satisfy it: it does nothing for a
  keyboard or touch visitor.

  The duplicate track is aria-hidden AND inert. aria-hidden on its own hides
  the copies from a screen reader while leaving their links focusable, which
  strands a keyboard visitor on a control they cannot perceive.

  Neither the component stylesheet nor the script loads for a single message,
  because a static bar has nothing to pause. This section renders on every page
  of the store, so that distinction is worth keeping.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign messages = section.blocks | where: 'type', 'message'
  assign is_marquee = false
  if messages.size > 1
    assign is_marquee = true
  endif

  assign pause_label = 'general.accessibility.pause_animation' | t
  assign play_label = 'general.accessibility.play_animation' | t
-%}

{%- if is_marquee -%}
  {{ 'component-marquee.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'kf-marquee.js' | asset_url }}" defer></script>
{%- endif -%}

{%- capture announcement_messages -%}
  {%- for block in messages -%}
    <span class="kf-announcement__item" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}
        <a class="kf-announcement__link" href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
      {%- else -%}
        {{ block.settings.text | escape }}
      {%- endif -%}
    </span>
    <span class="kf-announcement__separator" aria-hidden="true">&bull;</span>
  {%- endfor -%}
{%- endcapture -%}

{%- if messages.size > 0 -%}
  {%- if is_marquee -%}
    <kf-marquee
      class="kf-scheme kf-scheme--{{ s.color_scheme.id }} kf-announcement kf-announcement--marquee"
      style="--kf-marquee-duration: {{ s.speed }}s;"
      {% if s.pause_on_hover %}data-kf-pause-hover{% endif %}
    >
      <div class="kf-marquee{% if s.edge_fade %} kf-marquee--fade{% endif %}" data-kf-marquee>
        {%- for pass in (1..2) -%}
          <div
            class="kf-marquee__track"
            data-kf-marquee-track
            {% if pass == 2 %}aria-hidden="true" inert{% endif %}
          >
            {{ announcement_messages }}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%}
        Hidden until <kf-marquee> reveals it — a button that cannot work
        without the script should not be offered at all.
      {%- endcomment -%}
      <button
        class="kf-marquee-toggle"
        type="button"
        data-kf-marquee-toggle
        data-pause-label="{{ pause_label | escape }}"
        data-play-label="{{ play_label | escape }}"
        aria-label="{{ pause_label | escape }}"
        hidden
      >
        <span class="kf-marquee-toggle__icon kf-marquee-toggle__icon--pause">
          {%- render 'kf-icon', name: 'pause', size: 'sm' -%}
        </span>
        <span class="kf-marquee-toggle__icon kf-marquee-toggle__icon--play">
          {%- render 'kf-icon', name: 'play', size: 'sm' -%}
        </span>
      </button>
    </kf-marquee>
  {%- else -%}
    <div class="kf-scheme kf-scheme--{{ s.color_scheme.id }} kf-announcement">
      {%- for block in messages -%}
        <div class="kf-container kf-announcement__single" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="kf-announcement__link" href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
.kf-announcement {
  font-size: var(--kf-text-xs);
  letter-spacing: var(--kf-label-spacing);
  text-transform: var(--kf-label-transform);
  padding-block: 0.6rem;
}

.kf-announcement__single {
  display: flex;
  justify-content: center;
  text-align: center;
}

.kf-announcement__item {
  white-space: nowrap;
}

.kf-announcement__separator {
  opacity: 0.45;
}

.kf-announcement__link {
  text-decoration: underline;
  text-underline-offset: 0.25em;
  text-decoration-thickness: 1px;
}

/* Pause-on-hover now comes from component-marquee.css via
   `data-kf-pause-hover`, so it also covers :focus-within and is identical
   wherever a marquee appears. */

/* The pause control needs a 44px target, and the bar's own padding leaves it
   about 37px tall — without this the button would overhang into the header. */
.kf-announcement--marquee {
  display: flex;
  align-items: center;
  min-height: 2.75rem;
  padding-block: 0;
}

.kf-announcement--marquee .kf-marquee {
  flex: 1;
  min-width: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.kf-announcement-bar.name",
  "class": "kf-announcement-section",
  "enabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-announcement-bar.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.kf-announcement-bar.settings.header__1.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.kf-announcement-bar.settings.paragraph__2.content"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.kf-announcement-bar.settings.speed.label",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 30,
      "info": "t:sections.kf-announcement-bar.settings.speed.info"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.kf-announcement-bar.settings.pause_on_hover.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "t:sections.kf-announcement-bar.settings.edge_fade.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.kf-announcement-bar.blocks.message.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.kf-announcement-bar.blocks.message.settings.text.label",
          "default": "Complimentary shipping on orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.kf-announcement-bar.blocks.message.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-announcement-bar.presets.name",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
