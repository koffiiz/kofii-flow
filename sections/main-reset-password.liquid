{%- comment -%}
  Kofii Flow — Reset password
  ---------------------------------------------------------------------------
  Reached from the reset link emailed by `recover_customer_password` on the
  login page. Shopify validates the token before rendering this template, so
  there is no expired-link state for the theme to handle.

  `email` is provided by Shopify on this template, so the subtitle can name the
  account being reset — the one piece of context that stops a reset link
  feeling anonymous. Theme Check does not scope its object list per template
  and reports it as unknown, hence the disable directive below; the guard on
  the subtitle means a nil value simply hides the line rather than printing an
  empty sentence.
{%- endcomment -%}

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

{% # theme-check-disable UndefinedObject %}
{%- liquid
  assign s = section.settings

  assign page_title = 'customer.reset.title' | t
  assign page_subtitle = 'customer.reset.subtitle' | t: email: email
  assign submit_label = 'customer.reset.submit' | t

  assign password_label = 'customer.password' | t
  assign confirm_label = 'customer.password_confirm' | t
  assign errors_title = 'customer.errors_title' | t
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-account-section' %}>
  <div class="kf-container">
    <div class="kf-account">
      <header class="kf-account__header">
        <h1 class="kf-account__title {{ s.heading_size }}">{{ page_title }}</h1>
        {%- if email != blank -%}
          <p class="kf-account__subtitle kf-text-sm">{{ page_subtitle }}</p>
        {%- endif -%}
      </header>

      {%- form 'reset_customer_password', class: 'kf-account__form' -%}
        {%- if form.errors -%}
          <div class="kf-form-message kf-form-message--error kf-account__errors" role="alert">
            {%- render 'kf-icon', name: 'close', size: 'sm' -%}
            <div>
              <p>{{ errors_title }}</p>
              {{ form.errors | default_errors }}
            </div>
          </div>
        {%- endif -%}

        <div class="kf-field">
          <label class="kf-field__label" for="ResetPassword">{{ password_label }}</label>
          <input
            class="kf-input"
            type="password"
            id="ResetPassword"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="kf-field">
          <label class="kf-field__label" for="ResetPasswordConfirm">{{ confirm_label }}</label>
          <input
            class="kf-input"
            type="password"
            id="ResetPasswordConfirm"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
          >
        </div>

        {%- render 'kf-button', label: submit_label, type: 'submit', style: 'primary' -%}
      {%- endform -%}
      {% # theme-check-enable UndefinedObject %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "tag": "section",
  "class": "kf-account-page",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.main-reset-password.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h3",
          "label": "t:sections.main-reset-password.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.main-reset-password.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.main-reset-password.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-reset-password.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main-reset-password.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main-reset-password.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
