{%- comment -%}
  Kofii Flow — Tabs
  ---------------------------------------------------------------------------
  One panel visible at a time, with the WAI-ARIA tabs pattern driven by
  <kf-tabs>: arrow keys, Home and End, and a roving tabindex so the tablist is
  a single stop in the page's tab order.

  The markup is written for the state WITHOUT JavaScript first. Every panel is
  visible, each under a heading carrying its tab's label, and the tablist is
  hidden by CSS until the element marks itself ready. A visitor with no script
  gets a stacked document with headings — nothing hidden behind a control that
  cannot work. The element only ever hides what it can bring back.

  That is also why the label is rendered twice: once as the tab, once as the
  panel's heading. Only one of the two is ever displayed, so it is never read
  out or seen twice.

  Blocks are section-local: a tab is a label bound to a panel, which has no
  meaning outside this section.
{%- endcomment -%}

{{ 'section-tabs.css' | asset_url | stylesheet_tag }}
{{ 'component-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kf-tabs.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings

  assign has_header = false
  if s.heading != blank or s.eyebrow != blank or s.text != blank
    assign has_header = true
  endif

  assign tabbed = section.blocks | where: 'type', 'tab'

  assign media_sizes = '(min-width: 750px) 45vw, 100vw'
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-tabs-band' %}>
  <div class="kf-container">
    {%- if has_header -%}
      <header class="kf-section-header kf-tabs-band__header{% if s.alignment == 'center' %} kf-section-header--center{% endif %}">
        {%- if s.eyebrow != blank -%}
          <p class="kf-label kf-section-header__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="kf-section-header__text kf-rte">{{ s.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if tabbed.size > 0 -%}
      <kf-tabs>
        <div class="kf-tabs__list" role="tablist">
          {%- for block in tabbed -%}
            {%- liquid
              assign tab_id = 'KfTab-' | append: section.id | append: '-' | append: forloop.index
              assign panel_id = 'KfTabPanel-' | append: section.id | append: '-' | append: forloop.index
            -%}
            {%- comment -%}
              `aria-selected` and `tabindex` are written by the element rather
              than here. Until it runs the tablist is hidden anyway, and a
              button claiming to be selected while nothing responds to it would
              be a lie told to assistive technology.
            {%- endcomment -%}
            <button
              class="kf-tabs__tab"
              type="button"
              role="tab"
              id="{{ tab_id }}"
              aria-controls="{{ panel_id }}"
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in tabbed -%}
          {%- liquid
            assign b = block.settings
            assign tab_id = 'KfTab-' | append: section.id | append: '-' | append: forloop.index
            assign panel_id = 'KfTabPanel-' | append: section.id | append: '-' | append: forloop.index

            assign content_class = 'kf-tabs-band__content'
            if b.image != blank
              assign content_class = content_class | append: ' kf-tabs-band__content--split'
              if b.media_position == 'end'
                assign content_class = content_class | append: ' kf-tabs-band__content--media-end'
              endif
            endif
          -%}
          <div
            class="kf-tabs__panel"
            role="tabpanel"
            id="{{ panel_id }}"
            aria-labelledby="{{ tab_id }}"
            tabindex="0"
            {{ block.shopify_attributes }}
          >
            <h3 class="kf-tabs__panel-heading {{ s.panel_heading_size }}">{{ b.label | escape }}</h3>

            <div class="{{ content_class }}">
              {%- if b.image != blank -%}
                <div class="kf-tabs-band__media">
                  {%- render 'kf-media',
                    image: b.image,
                    ratio: s.media_ratio,
                    sizes: media_sizes
                  -%}
                </div>
              {%- endif -%}

              <div class="kf-tabs-band__body">
                {%- if b.text != blank -%}
                  <div class="kf-rte kf-tabs-band__text">{{ b.text }}</div>
                {%- endif -%}

                {%- if b.link_label != blank -%}
                  {%- render 'kf-button',
                    label: b.link_label,
                    href: b.link,
                    style: b.link_style,
                    icon: 'arrow'
                  -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </kf-tabs>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kf-tabs.name",
  "tag": "section",
  "class": "kf-tabs-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-tabs.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kf-tabs.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.kf-tabs.settings.heading.label",
      "default": "The details"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.kf-tabs.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h3",
          "label": "t:sections.kf-tabs.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-tabs.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.kf-tabs.settings.heading_size.options__3.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.kf-tabs.settings.text.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-tabs.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-tabs.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-tabs.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "panel_heading_size",
      "label": "t:sections.kf-tabs.settings.panel_heading_size.label",
      "info": "t:sections.kf-tabs.settings.panel_heading_size.info",
      "options": [
        {
          "value": "kf-h5",
          "label": "t:sections.kf-tabs.settings.panel_heading_size.options__1.label"
        },
        {
          "value": "kf-h4",
          "label": "t:sections.kf-tabs.settings.panel_heading_size.options__2.label"
        },
        {
          "value": "kf-h3",
          "label": "t:sections.kf-tabs.settings.panel_heading_size.options__3.label"
        }
      ],
      "default": "kf-h4"
    },
    {
      "type": "header",
      "content": "t:sections.kf-tabs.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.kf-tabs.settings.media_ratio.label",
      "info": "t:sections.kf-tabs.settings.media_ratio.info",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.kf-tabs.settings.media_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.kf-tabs.settings.media_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.kf-tabs.settings.media_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.kf-tabs.settings.media_ratio.options__4.label"
        },
        {
          "value": "wide",
          "label": "t:sections.kf-tabs.settings.media_ratio.options__5.label"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "t:sections.kf-tabs.settings.header__3.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-tabs.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-tabs.settings.section_transition.label",
      "info": "t:sections.kf-tabs.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-tabs.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-tabs.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-tabs.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-tabs.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-tabs.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.kf-tabs.blocks.tab.name",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.kf-tabs.blocks.tab.settings.label.label",
          "default": "Materials",
          "info": "t:sections.kf-tabs.blocks.tab.settings.label.info"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.kf-tabs.blocks.tab.settings.text.label",
          "default": "<p>What goes in this panel, in a paragraph or two.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.kf-tabs.blocks.tab.settings.image.label"
        },
        {
          "type": "select",
          "id": "media_position",
          "label": "t:sections.kf-tabs.blocks.tab.settings.media_position.label",
          "options": [
            {
              "value": "start",
              "label": "t:sections.kf-tabs.blocks.tab.settings.media_position.options__1.label"
            },
            {
              "value": "end",
              "label": "t:sections.kf-tabs.blocks.tab.settings.media_position.options__2.label"
            }
          ],
          "default": "start",
          "info": "t:sections.kf-tabs.blocks.tab.settings.media_position.info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.kf-tabs.blocks.tab.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.kf-tabs.blocks.tab.settings.link.label"
        },
        {
          "type": "select",
          "id": "link_style",
          "label": "t:sections.kf-tabs.blocks.tab.settings.link_style.label",
          "options": [
            {
              "value": "plain",
              "label": "t:sections.kf-tabs.blocks.tab.settings.link_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.kf-tabs.blocks.tab.settings.link_style.options__2.label"
            },
            {
              "value": "primary",
              "label": "t:sections.kf-tabs.blocks.tab.settings.link_style.options__3.label"
            }
          ],
          "default": "plain"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-tabs.presets.name",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "Materials"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Care"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
