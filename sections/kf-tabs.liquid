{%- comment -%}
  Kofii Flow — Tabs
  ---------------------------------------------------------------------------
  One panel visible at a time, with the WAI-ARIA tabs pattern driven by
  <kf-tabs>: arrow keys, Home and End, and a roving tabindex so the tablist is
  a single stop in the page's tab order.

  The markup is written for the state WITHOUT JavaScript first. Every panel is
  visible, each under a heading carrying its tab's label, and the tablist is
  hidden by CSS until the element marks itself ready. A visitor with no script
  gets a stacked document with headings — nothing hidden behind a control that
  cannot work. The element only ever hides what it can bring back.

  That is also why the label is rendered twice: once as the tab, once as the
  panel's heading. Only one of the two is ever displayed, so it is never read
  out or seen twice.

  Blocks are section-local: a tab is a label bound to a panel, which has no
  meaning outside this section.
{%- endcomment -%}

{{ 'section-tabs.css' | asset_url | stylesheet_tag }}
{{ 'component-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kf-tabs.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings

  assign has_header = false
  if s.heading != blank or s.eyebrow != blank or s.text != blank
    assign has_header = true
  endif

  assign tabbed = section.blocks | where: 'type', 'tab'

  assign media_sizes = '(min-width: 750px) 45vw, 100vw'
-%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-tabs-band' %}>
  <div class="kf-container">
    {%- if has_header -%}
      <header class="kf-section-header kf-tabs-band__header{% if s.alignment == 'center' %} kf-section-header--center{% endif %}">
        {%- if s.eyebrow != blank -%}
          <p class="kf-label kf-section-header__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="{{ s.heading_size }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="kf-section-header__text kf-rte">{{ s.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if tabbed.size > 0 -%}
      <kf-tabs>
        <div class="kf-tabs__list" role="tablist">
          {%- for block in tabbed -%}
            {%- liquid
              assign tab_id = 'KfTab-' | append: section.id | append: '-' | append: forloop.index
              assign panel_id = 'KfTabPanel-' | append: section.id | append: '-' | append: forloop.index
            -%}
            {%- comment -%}
              `aria-selected` and `tabindex` are written by the element rather
              than here. Until it runs the tablist is hidden anyway, and a
              button claiming to be selected while nothing responds to it would
              be a lie told to assistive technology.
            {%- endcomment -%}
            <button
              class="kf-tabs__tab"
              type="button"
              role="tab"
              id="{{ tab_id }}"
              aria-controls="{{ panel_id }}"
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in tabbed -%}
          {%- liquid
            assign b = block.settings
            assign tab_id = 'KfTab-' | append: section.id | append: '-' | append: forloop.index
            assign panel_id = 'KfTabPanel-' | append: section.id | append: '-' | append: forloop.index

            assign content_class = 'kf-tabs-band__content'
            if b.image != blank
              assign content_class = content_class | append: ' kf-tabs-band__content--split'
              if b.media_position == 'end'
                assign content_class = content_class | append: ' kf-tabs-band__content--media-end'
              endif
            endif
          -%}
          <div
            class="kf-tabs__panel"
            role="tabpanel"
            id="{{ panel_id }}"
            aria-labelledby="{{ tab_id }}"
            tabindex="0"
            {{ block.shopify_attributes }}
          >
            <h3 class="kf-tabs__panel-heading {{ s.panel_heading_size }}">{{ b.label | escape }}</h3>

            <div class="{{ content_class }}">
              {%- if b.image != blank -%}
                <div class="kf-tabs-band__media">
                  {%- render 'kf-media',
                    image: b.image,
                    ratio: s.media_ratio,
                    sizes: media_sizes
                  -%}
                </div>
              {%- endif -%}

              <div class="kf-tabs-band__body">
                {%- if b.text != blank -%}
                  <div class="kf-rte kf-tabs-band__text">{{ b.text }}</div>
                {%- endif -%}

                {%- if b.link_label != blank -%}
                  {%- render 'kf-button',
                    label: b.link_label,
                    href: b.link,
                    style: b.link_style,
                    icon: 'arrow'
                  -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </kf-tabs>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tabs",
  "tag": "section",
  "class": "kf-tabs-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The details"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "kf-h3", "label": "Small" },
        { "value": "kf-h2", "label": "Medium" },
        { "value": "kf-h1", "label": "Large" }
      ],
      "default": "kf-h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "panel_heading_size",
      "label": "Panel heading size",
      "info": "Only seen by visitors whose browser has not run the theme's JavaScript, where the tabs become a stacked list.",
      "options": [
        { "value": "kf-h5", "label": "Small" },
        { "value": "kf-h4", "label": "Medium" },
        { "value": "kf-h3", "label": "Large" }
      ],
      "default": "kf-h4"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image ratio",
      "info": "Only tabs with an image show one.",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "Transition into the next section",
      "info": "Requires section transitions to be enabled in Theme settings > Motion.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "round", "label": "Round the next section over this one" },
        { "value": "overlap", "label": "Overlap the next section" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Materials",
          "info": "Keep it to a word or two — long labels turn the tablist into a scroll."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>What goes in this panel, in a paragraph or two.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "media_position",
          "label": "Image position",
          "options": [
            { "value": "start", "label": "Left" },
            { "value": "end", "label": "Right" }
          ],
          "default": "start",
          "info": "Applies from 750px up."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "link_style",
          "label": "Link style",
          "options": [
            { "value": "plain", "label": "Text link" },
            { "value": "secondary", "label": "Outlined button" },
            { "value": "primary", "label": "Solid button" }
          ],
          "default": "plain"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Materials" } },
        { "type": "tab", "settings": { "label": "Care" } },
        { "type": "tab", "settings": { "label": "Shipping" } }
      ]
    }
  ]
}
{% endschema %}
