{%- comment -%}
  Kofii Flow — 404
  ---------------------------------------------------------------------------
  A dead end should still offer a way forward: search, and a route home.
{%- endcomment -%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: 'kf-404' %}>
  <div class="kf-container kf-container--narrow kf-404__inner">
    <p class="kf-label kf-text-accent">{{ 'sections.404.code' | t }}</p>

    <h1 class="kf-display-sm" {% render 'kf-motion-attrs', motion: section.settings %}>
      {{- 'sections.404.title' | t -}}
    </h1>

    <p class="kf-text-lg kf-text-muted">{{ 'sections.404.text' | t }}</p>

    {%- if section.settings.show_search -%}
      <div class="kf-404__search">
        {%- render 'kf-search-form', id: 'Error404', predictive: false -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Filters are not allowed on `render` arguments, so translation happens
      first and the result is passed in.
    {%- endcomment -%}
    {%- assign back_home_label = 'sections.404.back_home' | t -%}

    <div class="kf-button-group">
      {%- render 'kf-button',
        label: back_home_label,
        href: routes.root_url,
        style: 'primary',
        icon: 'arrow'
      -%}
    </div>
  </div>
</div>

{% stylesheet %}
.kf-404__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--kf-space-sm);
  text-align: center;
}

.kf-404__search {
  width: 100%;
  max-width: 26rem;
  margin-block: var(--kf-space-2xs);
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-404.name",
  "tag": "section",
  "class": "kf-404-section",
  "enabled_on": {
    "templates": [
      "404"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main-404.settings.show_search.label",
      "default": true
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.main-404.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-404.settings.animation.options__1.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.main-404.settings.animation.options__2.label"
        },
        {
          "value": "reveal",
          "label": "t:sections.main-404.settings.animation.options__3.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "select",
      "id": "animation_trigger",
      "label": "t:sections.main-404.settings.animation_trigger.label",
      "options": [
        {
          "value": "load",
          "label": "t:sections.main-404.settings.animation_trigger.options__1.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.main-404.settings.animation_trigger.options__2.label"
        }
      ],
      "default": "load"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-404.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.main-404.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.main-404.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
