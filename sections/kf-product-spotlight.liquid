    {
      "type": "checkbox",
      "id": "show_view_link",
      "label": "t:sections.kf-product-spotlight.settings.show_view_link.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.kf-product-spotlight.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.kf-product-spotlight.settings.layout.label",
      "options": [
        {
          "value": "media-left",
          "label": "t:sections.kf-product-spotlight.settings.layout.options__1.label"
        },
        {
          "value": "media-right",
          "label": "t:sections.kf-product-spotlight.settings.layout.options__2.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.kf-product-spotlight.settings.layout.options__3.label"
        }
      ],
      "default": "media-left"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:sections.kf-product-spotlight.settings.media_width.label",
      "info": "t:sections.kf-product-spotlight.settings.media_width.info",
      "options": [
        {
          "value": "small",
          "label": "t:sections.kf-product-spotlight.settings.media_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.kf-product-spotlight.settings.media_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.kf-product-spotlight.settings.media_width.options__3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.kf-product-spotlight.settings.content_position.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-product-spotlight.settings.content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-product-spotlight.settings.content_position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.kf-product-spotlight.settings.content_position.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.kf-product-spotlight.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-product-spotlight.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-product-spotlight.settings.alignment.options__2.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:sections.kf-product-spotlight.settings.header__4.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.kf-product-spotlight.settings.image.label",
      "info": "t:sections.kf-product-spotlight.settings.image.info"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "t:sections.kf-product-spotlight.settings.show_second_image.label",
      "default": false,
