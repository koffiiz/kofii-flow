{%- comment -%}
  Kofii Flow — Hero
  ---------------------------------------------------------------------------
  The flagship section. One section, seven layouts, all content supplied by
  theme blocks so the same hero can open a fashion store, a supplement brand
  or a furniture catalogue without new code.

  Layouts
    media-background  content over full-bleed media (supports full height)
    split             content left, media right
    split-reverse     media left, content right
    stacked           content above media
    centered          centered content, optional media behind
    editorial         asymmetric: oversized heading with offset media
    minimal           type only, generous space

  Motion: the content column is a Kofii Motion stagger container. Each block
  carries its own animation setting, and the hero sequences whichever blocks
  opt in. No animation code lives in this file.

  Performance: the hero image is the LCP element on most homepages, so it is
  loaded eagerly with fetchpriority="high" and never lazy-loaded.
{%- endcomment -%}

{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign layout = s.layout

  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif

  assign has_video = false
  if s.video != blank
    assign has_video = true
  endif

  assign has_media = false
  if has_image or has_video
    assign has_media = true
  endif

  assign is_background = false
  if layout == 'media-background'
    assign is_background = true
  endif
  if layout == 'centered' and has_media
    assign is_background = true
  endif

  assign hero_class = 'kf-hero kf-hero--' | append: layout
  assign hero_class = hero_class | append: ' kf-hero--h-' | append: s.height_desktop
  assign hero_class = hero_class | append: ' kf-hero--hm-' | append: s.height_mobile
  assign hero_class = hero_class | append: ' kf-hero--align-' | append: s.content_alignment
  assign hero_class = hero_class | append: ' kf-hero--pos-' | append: s.content_position
  assign hero_class = hero_class | append: ' kf-hero--w-' | append: s.content_width

  if is_background
    assign hero_class = hero_class | append: ' kf-hero--overlaid'
  endif
  if s.full_width
    assign hero_class = hero_class | append: ' kf-hero--full-width'
  endif

  assign parallax_strength = s.media_parallax | divided_by: 100.0

  comment
    A background hero paints its own media, so the section keeps the scheme
    tokens for the text but must not paint the scheme background over it.
  endcomment
  assign extra_style = ''
  if is_background
    assign extra_style = 'background-color: transparent;'
  endif
-%}

<div
  id="kf-hero-{{ section.id }}"
  {% render 'kf-section-attrs',
    s: section.settings,
    extra_class: hero_class,
    style: extra_style,
    full_width: s.full_width %}
>
  {%- if is_background and has_media -%}
    <div class="kf-hero__backdrop">
      {%- if has_video -%}
        {{
          s.video
          | video_tag:
            class: 'kf-hero__video',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            image_size: '1920x'
        }}
      {%- else -%}
        {%- render 'kf-media',
          image: s.image,
          ratio: 'wide',
          sizes: '100vw',
          loading: 'eager',
          priority: true,
          parallax: parallax_strength,
          flush: true,
          class: 'kf-hero__media kf-hero__media--fill'
        -%}
      {%- endif -%}

      {%- if s.overlay_opacity > 0 -%}
        <div
          class="kf-hero__overlay{% if s.overlay_style == 'gradient' %} kf-hero__overlay--gradient{% endif %}"
          style="--kf-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};{% if s.overlay_color != blank %}--kf-overlay-color: {{ s.overlay_color }};{% endif %}"
        ></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="kf-container kf-hero__inner">
    <div
      class="kf-hero__content"
      {% render 'kf-motion-attrs', motion: section.settings %}
    >
      {% content_for 'blocks' %}
    </div>

    {%- comment -%}
      Side-by-side and stacked layouts render the media as a real column so it
      participates in the grid instead of sitting behind the text.
    {%- endcomment -%}
    {%- unless is_background -%}
      {%- if has_media or s.show_media_placeholder -%}
        <div class="kf-hero__media-col">
          {%- if has_video -%}
            {{
              s.video
              | video_tag:
                class: 'kf-hero__video',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                image_size: '1200x'
            }}
          {%- else -%}
            {%- render 'kf-media',
              image: s.image,
              ratio: s.media_ratio,
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'eager',
              priority: true,
              parallax: parallax_strength,
              placeholder: 'lifestyle-2',
              class: 'kf-hero__media'
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endunless -%}
  </div>
</div>

