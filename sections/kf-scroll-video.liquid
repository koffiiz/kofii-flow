        },
        {
          "value": "kf-h3",
          "label": "t:sections.kf-scroll-video.settings.caption_heading_size.options__2.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-scroll-video.settings.caption_heading_size.options__3.label"
        }
      ],
      "default": "kf-h3"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "t:sections.kf-scroll-video.settings.show_numbers.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "t:sections.kf-scroll-video.settings.show_progress.label",
      "default": true,
      "info": "t:sections.kf-scroll-video.settings.show_progress.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-scroll-video.settings.header__5.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.kf-scroll-video.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-scroll-video.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.kf-scroll-video.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.kf-scroll-video.settings.animation.options__3.label"
        },
        {
          "value": "blur-in",
          "label": "t:sections.kf-scroll-video.settings.animation.options__4.label"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:sections.kf-scroll-video.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.kf-scroll-video.settings.header__6.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-scroll-video.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-scroll-video.settings.section_transition.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-scroll-video.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-scroll-video.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-scroll-video.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
