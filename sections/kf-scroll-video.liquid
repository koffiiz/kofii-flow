          "label": "t:sections.kf-scroll-video.settings.caption_position.options__3.label"
        }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "caption_alignment",
      "label": "t:sections.kf-scroll-video.settings.caption_alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.kf-scroll-video.settings.caption_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.kf-scroll-video.settings.caption_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.kf-scroll-video.settings.caption_alignment.options__3.label"
        }
      ],
      "default": "start"
