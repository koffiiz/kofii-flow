          "id": "heading",
          "label": "t:sections.kf-scroll-video.blocks.caption.settings.heading.label",
          "default": "The first moment"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.kf-scroll-video.blocks.caption.settings.text.label",
          "default": "<p>One thought per caption. It has to land while its stretch of the video is on screen.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.kf-scroll-video.blocks.caption.settings.link_label.label"
        },
