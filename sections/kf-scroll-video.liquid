      "limit": 6,
      "settings": [
        {
          "type": "range",
          "id": "start",
          "label": "t:sections.kf-scroll-video.blocks.caption.settings.start.label",
          "info": "t:sections.kf-scroll-video.blocks.caption.settings.start.info",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        },
