{%- comment -%}
  Kofii Flow — Marquee
  ---------------------------------------------------------------------------
  A band of text or images scrolling continuously. Two uses in one section: an
  oversized statement band, and a moving logo or badge strip.

  The scrolling is the shared implementation in kf-motion.css, the same one the
  announcement bar uses — two tracks duplicated in the markup, animated with
  `@keyframes kf-marquee`. It runs with no JavaScript at all.

  The viewport, tracks and pause button are `snippets/kf-marquee-track.liquid`,
  shared with the logo cloud's scrolling layout.

  <kf-marquee> adds the two things CSS cannot: the pause control that WCAG 2.2
  SC 2.2.2 requires for self-starting motion, and enough repeats of a short
  item list to fill the viewport (the track carries `min-width: 100%`, so three
  short words would otherwise stretch and trail a dead gap on every pass).

  The separator is emitted AFTER every item including the last. That is what
  keeps the spacing even across the seam where the loop repeats — drop it on
  the last item and the join gets visibly tighter than the rest.

  Blocks are section-local: a marquee item is a scrap of text or one image, not
  a content unit worth exposing to other sections.
{%- endcomment -%}

{{ 'section-marquee.css' | asset_url | stylesheet_tag }}
{{ 'component-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kf-marquee.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings

  assign band_class = 'kf-marquee-band'
  if s.uppercase
    assign band_class = band_class | append: ' kf-marquee-band--uppercase'
  endif

  comment
    The shared keyframes always travel one direction; `animation-direction`
    is what reverses them, so there is only ever one set of keyframes.
  endcomment
  assign direction = 'normal'
  if s.direction == 'right'
    assign direction = 'reverse'
  endif

  assign band_style = '--kf-marquee-duration: ' | append: s.speed | append: 's;'
  assign band_style = band_style | append: ' --kf-marquee-direction: ' | append: direction | append: ';'
  assign band_style = band_style | append: ' --kf-marquee-gap: ' | append: s.gap | append: 'px;'
  assign band_style = band_style | append: ' --kf-marquee-image-height: ' | append: s.image_height | append: 'px;'

  case s.separator
    when 'dot'
      assign separator_mark = '&bull;'
    when 'slash'
      assign separator_mark = '/'
    when 'asterisk'
      assign separator_mark = '&lowast;'
    else
      assign separator_mark = ''
  endcase

  assign image_sizes = '(min-width: 750px) 20vw, 40vw'
-%}

{%- capture marquee_items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign item_class = 'kf-marquee-band__item'
      if block.type == 'text' and block.settings.text_style == 'outline'
        assign item_class = item_class | append: ' kf-marquee-band__item--outline'
      endif
    -%}
    <div class="{{ item_class }}" {{ block.shopify_attributes }}>
      {%- if block.type == 'image' -%}
        {%- if block.settings.link != blank -%}<a class="kf-marquee-band__link" href="{{ block.settings.link }}">{%- endif -%}
        {%- render 'kf-media',
          image: block.settings.image,
          ratio: 'adapt',
          fit: 'contain',
          flush: true,
          sizes: image_sizes,
          placeholder: 'image',
          class: 'kf-marquee-band__media'
        -%}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      {%- else -%}
        {%- if block.settings.link != blank -%}
          <a class="kf-marquee-band__link" href="{{ block.settings.link }}">
            <span class="kf-marquee-band__text {{ s.text_size }}">{{ block.settings.text | escape }}</span>
          </a>
        {%- else -%}
          <span class="kf-marquee-band__text {{ s.text_size }}">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if separator_mark != blank -%}
      <span class="kf-marquee-band__separator {{ s.text_size }}" aria-hidden="true">{{ separator_mark }}</span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div {% render 'kf-section-attrs', s: section.settings, extra_class: band_class, style: band_style %}>
  {%- if section.blocks.size > 0 -%}
    {%- unless s.full_width -%}<div class="kf-container">{%- endunless -%}

    {%- render 'kf-marquee-track',
      items: marquee_items,
      pause_on_hover: s.pause_on_hover,
      edge_fade: s.edge_fade
    -%}

    {%- unless s.full_width -%}</div>{%- endunless -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.kf-marquee.name",
  "tag": "section",
  "class": "kf-marquee-band-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.kf-marquee.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:sections.kf-marquee.settings.text_size.label",
      "options": [
        {
          "value": "kf-h5",
          "label": "t:sections.kf-marquee.settings.text_size.options__1.label"
        },
        {
          "value": "kf-h4",
          "label": "t:sections.kf-marquee.settings.text_size.options__2.label"
        },
        {
          "value": "kf-h3",
          "label": "t:sections.kf-marquee.settings.text_size.options__3.label"
        },
        {
          "value": "kf-h2",
          "label": "t:sections.kf-marquee.settings.text_size.options__4.label"
        },
        {
          "value": "kf-h1",
          "label": "t:sections.kf-marquee.settings.text_size.options__5.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "t:sections.kf-marquee.settings.uppercase.label",
      "default": true
    },
    {
      "type": "select",
      "id": "separator",
      "label": "t:sections.kf-marquee.settings.separator.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-marquee.settings.separator.options__1.label"
        },
        {
          "value": "dot",
          "label": "t:sections.kf-marquee.settings.separator.options__2.label"
        },
        {
          "value": "slash",
          "label": "t:sections.kf-marquee.settings.separator.options__3.label"
        },
        {
          "value": "asterisk",
          "label": "t:sections.kf-marquee.settings.separator.options__4.label"
        }
      ],
      "default": "dot"
    },
    {
      "type": "header",
      "content": "t:sections.kf-marquee.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.kf-marquee.settings.full_width.label",
      "default": true,
      "info": "t:sections.kf-marquee.settings.full_width.info"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:sections.kf-marquee.settings.gap.label",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "t:sections.kf-marquee.settings.image_height.label",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48,
      "info": "t:sections.kf-marquee.settings.image_height.info"
    },
    {
      "type": "header",
      "content": "t:sections.kf-marquee.settings.header__3.content"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.kf-marquee.settings.speed.label",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40,
      "info": "t:sections.kf-marquee.settings.speed.info"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.kf-marquee.settings.direction.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.kf-marquee.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.kf-marquee.settings.direction.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.kf-marquee.settings.pause_on_hover.label",
      "default": true,
      "info": "t:sections.kf-marquee.settings.pause_on_hover.info"
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "t:sections.kf-marquee.settings.edge_fade.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.kf-marquee.settings.header__4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.kf-marquee.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_transition",
      "label": "t:sections.kf-marquee.settings.section_transition.label",
      "info": "t:sections.kf-marquee.settings.section_transition.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.kf-marquee.settings.section_transition.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.kf-marquee.settings.section_transition.options__2.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.kf-marquee.settings.section_transition.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.kf-marquee.settings.padding_top.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.kf-marquee.settings.padding_bottom.label",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.kf-marquee.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.kf-marquee.blocks.text.settings.text.label",
          "default": "Free shipping over $75"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "t:sections.kf-marquee.blocks.text.settings.text_style.label",
          "options": [
            {
              "value": "solid",
              "label": "t:sections.kf-marquee.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "outline",
              "label": "t:sections.kf-marquee.blocks.text.settings.text_style.options__2.label"
            }
          ],
          "default": "solid"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.kf-marquee.blocks.text.settings.link.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.kf-marquee.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.kf-marquee.blocks.image.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.kf-marquee.blocks.image.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kf-marquee.presets.name",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "Free shipping over $75"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "30 day returns"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Made in small batches"
          }
        }
      ]
    }
  ]
}
{% endschema %}
