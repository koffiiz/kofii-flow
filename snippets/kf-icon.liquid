{%- comment -%}
  Kofii Flow — Icon set
  ---------------------------------------------------------------------------
  Usage:
    {% render 'kf-icon', name: 'search' %}
    {% render 'kf-icon', name: 'arrow', class: 'kf-button__icon' %}

  Parameters:
    name    (string, required)  icon key, see the case statement below
    class   (string)            extra classes; defaults to `kf-icon`
    size    (string)            'sm' | 'lg' to use a preset size

  Icons are decorative by default (aria-hidden). Label the control that
  contains them, never the icon itself.
{%- endcomment -%}

{%- liquid
  assign icon_class = 'kf-icon'
  if size == 'sm'
    assign icon_class = icon_class | append: ' kf-icon--sm'
  elsif size == 'lg'
    assign icon_class = icon_class | append: ' kf-icon--lg'
  endif
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}

{%- case name -%}
  {%- when 'menu' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18"/></svg>

  {%- when 'close' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>

  {%- when 'search' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>

  {%- when 'cart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16l-1.2 12.1a2 2 0 0 1-2 1.9H7.2a2 2 0 0 1-2-1.9L4 7Z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/></svg>

  {%- when 'account' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="3.75"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>

  {%- when 'chevron' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9.5l6 6 6-6"/></svg>

  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 6l6 6-6 6"/></svg>

  {%- when 'arrow' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15"/><path d="M13 6l6 6-6 6"/></svg>

  {%- when 'arrow-diagonal' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7"/><path d="M8.5 7H17v8.5"/></svg>

  {%- when 'plus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>

  {%- when 'minus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>

  {%- when 'check' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 12.5l5 5 10-11"/></svg>

  {%- when 'star' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.9l6.1-.8L12 3.5Z"/></svg>

  {%- when 'play' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>

  {%- when 'pause' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5h3.2v14H8V5Zm4.8 0H16v14h-3.2V5Z"/></svg>

  {%- when 'globe' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.2 2.4 3.4 5.4 3.4 8.5s-1.2 6.1-3.4 8.5c-2.2-2.4-3.4-5.4-3.4-8.5S9.8 5.9 12 3.5Z"/></svg>

  {%- when 'spinner' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" opacity="0.25"/><path d="M21 12a9 9 0 0 0-9-9"/></svg>

  {%- when 'instagram' -%}
