  {%- when 'tiktok' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.6 2.2h-3.1v13.2a2.6 2.6 0 1 1-2.6-2.6c.2 0 .5 0 .7.1v-3.2a5.9 5.9 0 0 0-.7 0 5.8 5.8 0 1 0 5.8 5.8V9.3a7 7 0 0 0 4.1 1.3V7.4a3.9 3.9 0 0 1-4.2-3.9v-1.3Z"/></svg>

  {%- when 'youtube' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.9 4.8 12 4.8 12 4.8s-6.9 0-8.6.5A2.7 2.7 0 0 0 1.5 7.2 28.3 28.3 0 0 0 1 12a28.3 28.3 0 0 0 .5 4.8 2.7 2.7 0 0 0 1.9 1.9c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9A28.3 28.3 0 0 0 23 12a28.3 28.3 0 0 0-.5-4.8ZM9.8 15.3V8.7l5.7 3.3Z"/></svg>

  {%- when 'facebook' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>

  {%- when 'twitter' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.5 3h3.2l-7 8 8.2 10h-6.4l-5-6.1-5.7 6.1H1.6l7.5-8.6L1.2 3h6.6l4.5 5.6ZM16.4 19.2h1.8L7.7 4.7H5.8Z"/></svg>

  {%- when 'pinterest' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.2a9.8 9.8 0 0 0-3.6 18.9 9.4 9.4 0 0 1 .1-2.8l1.1-4.8a3.5 3.5 0 0 1-.3-1.4c0-1.4.8-2.4 1.8-2.4a1.2 1.2 0 0 1 1.2 1.4 19.4 19.4 0 0 1-.8 3.2 1.4 1.4 0 0 0 1.4 1.7c1.7 0 3-1.8 3-4.4a3.8 3.8 0 0 0-4-3.9 4.1 4.1 0 0 0-4.3 4.1 3.7 3.7 0 0 0 .7 2.2.3.3 0 0 1 .1.3l-.3 1.1c0 .2-.1.2-.3.1-1.2-.5-1.9-2.2-1.9-3.6 0-2.9 2.1-5.6 6.1-5.6a5.4 5.4 0 0 1 5.7 5.3c0 3.2-2 5.7-4.8 5.7a2.5 2.5 0 0 1-2.1-1.1l-.6 2.2a10.4 10.4 0 0 1-1.2 2.5A9.8 9.8 0 1 0 12 2.2Z"/></svg>

  {%- when 'linkedin' -%}
    <svg class="{{ icon_class }} kf-icon--filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.9 21.5H3.1V9.2h3.8ZM5 7.5A2.2 2.2 0 1 1 7.2 5.3 2.2 2.2 0 0 1 5 7.5Zm16.5 14h-3.8v-6c0-1.4 0-3.2-2-3.2s-2.3 1.6-2.3 3.1v6.1H9.6V9.2h3.6v1.7a4 4 0 0 1 3.6-2c3.8 0 4.5 2.5 4.5 5.8Z"/></svg>

  {%- else -%}
    {%- comment -%} Unknown icon names render nothing rather than a broken box. {%- endcomment -%}
{%- endcase -%}
