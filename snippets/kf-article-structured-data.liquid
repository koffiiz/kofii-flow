{%- comment -%}
  Kofii Flow — Article structured data
  ---------------------------------------------------------------------------
  Article JSON-LD, emitted once by `sections/main-article.liquid`.

  Kept out of `kf-structured-data.liquid` for the same reason the product graph
  is: that snippet emits the site-level Organization and WebSite graph on the
  homepage only, so no page ever declares the same entity twice.

  Note there is no literal `}` anywhere inside an output tag here. Shopify ends
  a `{{ … }}` at the FIRST `}` it sees, so one brace inside would truncate the
  tag and the theme would be rejected on upload — see rule 12 in CLAUDE.md.

  Parameters:
    article (object, required)
    blog    (object, required)
{%- endcomment -%}

{%- liquid
  assign article_summary = article.excerpt_or_content | strip_html | truncate: 500
  assign article_url = article.url | prepend: shop.url
  assign publisher_id = shop.url | append: '#organization'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ article_url | json }}
    },
    "headline": {{ article.title | json }},
    "description": {{ article_summary | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    {%- if article.image -%}
      {%- assign article_image = article.image | image_url: width: 1600 | prepend: 'https:' -%}
      "image": {{ article_image | json }},
    {%- endif -%}
    {%- if article.author != blank -%}
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
    {%- endif -%}
    "publisher": {
      "@type": "Organization",
      "@id": {{ publisher_id | json }},
      "name": {{ shop.name | json }}
    },
    "isPartOf": {
      "@type": "Blog",
      "name": {{ blog.title | json }}
    }
  }
</script>
