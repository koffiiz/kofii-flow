{%- comment -%}
  Kofii Flow — Star rating
  ---------------------------------------------------------------------------
  Two rows of five stars, the filled one clipped to a percentage. That is why
  the row count is fixed at five while the score can be out of any maximum:
  the fill is a width, so 5 out of 10 draws two and a half stars correctly.

  The stars are aria-hidden and followed by a visually hidden sentence, so the
  score is announced once as words instead of as ten star icons.

  Usage:
    {% render 'kf-stars', rating: 4.5 %}
    {% render 'kf-stars', rating: r.rating, scale_max: r.scale_max %}

  Parameters:
    rating     (number, required)
    scale_max  (number)   defaults to 5
    label      (string)   overrides the announced sentence; use it where the
                          score is not a product review
{%- endcomment -%}

{%- liquid
  assign stars_max = scale_max | default: 5
  assign stars_percent = rating | times: 100.0 | divided_by: stars_max

  assign stars_label = label
  if stars_label == blank
    assign stars_label = 'products.product.rating_value' | t: rating: rating, max: stars_max
  endif
-%}

<span class="kf-stars" aria-hidden="true" style="--kf-rating: {{ stars_percent }}%;">
  <span class="kf-stars__row">
    {%- for i in (1..5) -%}{%- render 'kf-icon', name: 'star', size: 'sm' -%}{%- endfor -%}
  </span>
  <span class="kf-stars__row kf-stars__row--fill">
    {%- for i in (1..5) -%}{%- render 'kf-icon', name: 'star', size: 'sm' -%}{%- endfor -%}
  </span>
</span>
<span class="kf-visually-hidden">{{ stars_label }}</span>
