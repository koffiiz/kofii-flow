{%- comment -%}
  Kofii Flow — Trust row
  ---------------------------------------------------------------------------
  A short row of reassurances under a hero or a buy button. Accepts nested
  `_trust-item` blocks so a merchant can add, remove and reorder them.
{%- endcomment -%}

{%- if block.blocks.size > 0 -%}
  <ul
    class="kf-trust"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </ul>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.trust-row.name",
  "tag": null,
  "blocks": [
    {
      "type": "_trust-item"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.trust-row.settings.paragraph__1.content"
    },
    {
      "type": "header",
      "content": "t:blocks.trust-row.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.trust-row.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.trust-row.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.trust-row.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.trust-row.settings.animation.options__3.label"
        },
        {
          "value": "blur-in",
          "label": "t:blocks.trust-row.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.trust-row.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.trust-row.presets.name",
      "blocks": [
        {
          "type": "_trust-item"
        },
        {
          "type": "_trust-item"
        },
        {
          "type": "_trust-item"
        }
      ]
    }
  ]
}
{% endschema %}
