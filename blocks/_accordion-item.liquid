{%- comment -%}
  Kofii Flow — Accordion item
  ---------------------------------------------------------------------------
  A private theme block (leading underscore): only usable inside blocks that
  explicitly allow it. Used by blocks/product-accordion.liquid.

  Content can come from a page, a metafield or typed text, so merchants can
  reuse one shipping policy across every product instead of retyping it.
{%- endcomment -%}

{%- liquid
  assign body = block.settings.content
  if block.settings.page != blank
    assign body = block.settings.page.content
  endif
-%}

{%- if block.settings.heading != blank -%}
  <details class="kf-accordion__item" {{ block.shopify_attributes }}>
    <summary class="kf-accordion__summary">
      <span class="kf-cluster">
        {%- if block.settings.icon != 'none' -%}
          {%- render 'kf-icon', name: block.settings.icon, size: 'sm' -%}
        {%- endif -%}
        <span>{{ block.settings.heading | escape }}</span>
      </span>
      {%- render 'kf-icon', name: 'chevron', class: 'kf-accordion__icon', size: 'sm' -%}
    </summary>

    <div class="kf-accordion__panel">
      <div class="kf-accordion__panel-inner kf-rte kf-text-sm">
        {{ body }}
      </div>
    </div>
  </details>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks._accordion-item.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks._accordion-item.settings.heading.label",
      "default": "Shipping and returns"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:blocks._accordion-item.settings.content.label",
      "default": "<p>Describe delivery times, costs and how returns work.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:blocks._accordion-item.settings.page.label",
      "info": "t:blocks._accordion-item.settings.page.info"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks._accordion-item.settings.icon.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks._accordion-item.settings.icon.options__1.label"
        },
        {
          "value": "check",
          "label": "t:blocks._accordion-item.settings.icon.options__2.label"
        },
        {
          "value": "star",
          "label": "t:blocks._accordion-item.settings.icon.options__3.label"
        },
        {
          "value": "globe",
          "label": "t:blocks._accordion-item.settings.icon.options__4.label"
        },
        {
          "value": "cart",
          "label": "t:blocks._accordion-item.settings.icon.options__5.label"
        }
      ],
      "default": "none"
    }
  ]
}
{% endschema %}
