{%- comment -%}
  Kofii Flow — Image block
  Renders through snippets/kf-media.liquid, so ratio handling, srcset, focal
  point and hover behaviour match every other image in the theme.
{%- endcomment -%}

{%- liquid
  assign wrapper_class = 'kf-block-image'
  case block.settings.width
    when 'narrow'
      assign wrapper_class = wrapper_class | append: ' kf-block-image--narrow'
    when 'medium'
      assign wrapper_class = wrapper_class | append: ' kf-block-image--medium'
  endcase

  assign parallax_strength = block.settings.parallax | divided_by: 100.0

  assign link_label = block.settings.image.alt
  if link_label == blank
    assign link_label = 'general.accessibility.image_link' | t
  endif
-%}

<div
  class="{{ wrapper_class }}"
  {% render 'kf-motion-attrs', motion: block.settings %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" aria-label="{{ link_label | escape }}">
  {%- endif -%}

  {%- render 'kf-media',
    image: block.settings.image,
    ratio: block.settings.ratio,
    sizes: '(min-width: 990px) 50vw, 100vw',
    zoom: block.settings.hover_zoom,
    parallax: parallax_strength,
    placeholder: 'image',
    flush: block.settings.flush
  -%}

  {%- if block.settings.link != blank -%}
    </a>
  {%- endif -%}

  {%- if block.settings.caption != blank -%}
    <p class="kf-block-image__caption kf-text-sm kf-text-muted">{{ block.settings.caption | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.image.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.image.settings.image.label"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:blocks.image.settings.ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:blocks.image.settings.ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:blocks.image.settings.ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:blocks.image.settings.ratio.options__3.label"
        },
        {
          "value": "tall",
          "label": "t:blocks.image.settings.ratio.options__4.label"
        },
        {
          "value": "landscape",
          "label": "t:blocks.image.settings.ratio.options__5.label"
        },
        {
          "value": "wide",
          "label": "t:blocks.image.settings.ratio.options__6.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.image.settings.width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:blocks.image.settings.width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:blocks.image.settings.width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:blocks.image.settings.width.options__3.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.image.settings.link.label"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:blocks.image.settings.caption.label"
    },
    {
      "type": "header",
      "content": "t:blocks.image.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "flush",
      "label": "t:blocks.image.settings.flush.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "t:blocks.image.settings.hover_zoom.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.image.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.image.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.image.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.image.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.image.settings.animation.options__3.label"
        },
        {
          "value": "scale-up",
          "label": "t:blocks.image.settings.animation.options__4.label"
        },
        {
          "value": "zoom-in",
          "label": "t:blocks.image.settings.animation.options__5.label"
        },
        {
          "value": "blur-in",
          "label": "t:blocks.image.settings.animation.options__6.label"
        },
        {
          "value": "clip-up",
          "label": "t:blocks.image.settings.animation.options__7.label"
        },
        {
          "value": "clip-left",
          "label": "t:blocks.image.settings.animation.options__8.label"
        },
        {
          "value": "reveal",
          "label": "t:blocks.image.settings.animation.options__9.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.image.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    },
    {
      "type": "range",
      "id": "parallax",
      "label": "t:blocks.image.settings.parallax.label",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "t:blocks.image.settings.parallax.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.image.presets.name"
    }
  ]
}
{% endschema %}
