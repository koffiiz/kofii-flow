{%- comment -%}
  Kofii Flow — Buy buttons block
  ---------------------------------------------------------------------------
  A thin wrapper over `snippets/kf-buy-buttons.liquid`, which is also rendered
  by the quick add panel.

  The form is `KfProductForm-<product.id>`. The variant picker, the quantity
  block and the sticky bar all bind to it with the HTML `form` attribute rather
  than duplicating it — one form, one variant input, one add-to-cart path.
{%- endcomment -%}

{%- liquid
  assign target = closest.product
  assign form_id = 'KfProductForm-' | append: target.id
-%}

{%- if target != blank -%}
  <div {{ block.shopify_attributes }}>
    {%- render 'kf-buy-buttons',
      product: target,
      form_id: form_id,
      scope: 'Product',
      show_dynamic_checkout: block.settings.show_dynamic_checkout,
      show_payment_terms: block.settings.show_payment_terms
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product-buy-buttons.name",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:blocks.product-buy-buttons.settings.show_dynamic_checkout.label",
      "default": true,
      "info": "t:blocks.product-buy-buttons.settings.show_dynamic_checkout.info"
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "t:blocks.product-buy-buttons.settings.show_payment_terms.label",
      "default": true,
      "info": "t:blocks.product-buy-buttons.settings.show_payment_terms.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-buy-buttons.presets.name"
    }
  ]
}
{% endschema %}
