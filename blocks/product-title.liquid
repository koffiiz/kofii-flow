{%- comment -%}
  Kofii Flow — Product title block
  ---------------------------------------------------------------------------
  Uses `closest.product`, so the same block works in main-product today and in
  a product spotlight or quick view later without changes.

  The visual size and the heading level are separate settings: the product
  title should be the page <h1> even when it is styled small.
{%- endcomment -%}

{%- liquid
  assign target = closest.product
  assign tag = block.settings.heading_tag | default: 'h1'
-%}

{%- if target != blank -%}
  <{{ tag }}
    class="kf-product__title {{ block.settings.heading_size }}"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {{- target.title | escape -}}
  </{{ tag }}>
{%- else -%}
  <p class="kf-product__title kf-h3 kf-muted" {{ block.shopify_attributes }}>
    {{ 'products.product.placeholder_title' | t }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product-title.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:blocks.product-title.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h4",
          "label": "t:blocks.product-title.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h3",
          "label": "t:blocks.product-title.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h2",
          "label": "t:blocks.product-title.settings.heading_size.options__3.label"
        },
        {
          "value": "kf-h1",
          "label": "t:blocks.product-title.settings.heading_size.options__4.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:blocks.product-title.settings.heading_tag.label",
      "info": "t:blocks.product-title.settings.heading_tag.info",
      "options": [
        {
          "value": "h1",
          "label": "t:blocks.product-title.settings.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:blocks.product-title.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:blocks.product-title.settings.heading_tag.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "t:blocks.product-title.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.product-title.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.product-title.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.product-title.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.product-title.settings.animation.options__3.label"
        },
        {
          "value": "reveal",
          "label": "t:blocks.product-title.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.product-title.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-title.presets.name"
    }
  ]
}
{% endschema %}
