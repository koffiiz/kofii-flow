{%- comment -%}
  Kofii Flow — Variant picker block
  ---------------------------------------------------------------------------
  Renders one control group per product option. Swatches come from Shopify's
  native option-value swatches (Products > Options), so merchants configure
  colors in the admin rather than in Liquid or a metafield convention.

  Form association
    The picker sits outside the product form on purpose — the form submits a
    single hidden `id` input which the picker updates. That keeps one source of
    truth for the chosen variant no matter how many controls are on the page.
    Both blocks derive the form id the same way: `KfProductForm-<product.id>`.

  Without JavaScript
    A <noscript> <select name="id"> lists every variant and is bound to the
    product form with the `form` attribute, so the page remains fully
    purchasable with scripting disabled.
{%- endcomment -%}

{%- liquid
  assign target = closest.product

  assign picker_style = block.settings.style
  assign form_id = 'KfProductForm-' | append: target.id

  assign single_variant = false
  if target.has_only_default_variant
    assign single_variant = true
  endif
-%}

{%- if target != blank and single_variant == false -%}
  <kf-variant-picker
    class="kf-variant-picker kf-stack"
    data-product-url="{{ target.url }}"
    data-update-url="{{ block.settings.update_url }}"
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-kf-variant-data>
      [
        {%- for variant in target.variants -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "options": {{ variant.options | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>

    {%- for option in target.options_with_values -%}
      {%- liquid
        assign option_index = forloop.index0
        assign group_name = 'kf-option-' | append: target.id | append: '-' | append: option.position

        assign has_swatch = false
        for value in option.values
          if value.swatch
            assign has_swatch = true
            break
          endif
        endfor

        assign render_as = picker_style
        if picker_style == 'auto'
          if has_swatch
            assign render_as = 'swatches'
          else
            assign render_as = 'buttons'
          endif
        endif
      -%}

      {%- if render_as == 'dropdown' -%}
        <div class="kf-field kf-variant-option" data-option-index="{{ option_index }}">
          <label class="kf-field__label" for="{{ group_name }}">{{ option.name | escape }}</label>
          <select class="kf-select" id="{{ group_name }}" name="{{ group_name }}">
            {%- for value in option.values -%}
              <option
                value="{{ value.name | escape }}"
                data-option-value="{{ value.name | escape }}"
                {% if value.selected %}selected{% endif %}
                {% unless value.available %}data-unavailable{% endunless %}
              >
                {{ value.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <fieldset class="kf-variant-option" data-option-index="{{ option_index }}">
          <legend class="kf-variant-option__legend">
            <span>{{ option.name | escape }}</span>
            {%- if block.settings.show_selected_value -%}
              <span class="kf-variant-option__value" data-kf-option-display>{{ option.selected_value | escape }}</span>
            {%- endif -%}
          </legend>

          <div class="kf-variant-option__values">
            {%- for value in option.values -%}
              {%- assign input_id = group_name | append: '-' | append: forloop.index -%}
              <span
                data-option-value="{{ value.name | escape }}"
                {% unless value.available %}data-unavailable{% endunless %}
              >
                <input
                  class="kf-variant-option__input"
                  type="radio"
                  id="{{ input_id }}"
                  name="{{ group_name }}"
                  value="{{ value.name | escape }}"
                  {% if value.selected %}checked{% endif %}
                >
                {%- if render_as == 'swatches' and value.swatch -%}
                  <label
                    class="kf-variant-swatch"
                    for="{{ input_id }}"
                    title="{{ value.name | escape }}"
                    style="
                      {%- if value.swatch.image -%}
                        --kf-swatch-image: url({{ value.swatch.image | image_url: width: 96 }});
                      {%- elsif value.swatch.color -%}
                        --kf-swatch-color: {{ value.swatch.color }};
                      {%- endif -%}
                    "
                  >
                    <span class="kf-visually-hidden">{{ value.name }}</span>
                  </label>
                {%- else -%}
                  <label class="kf-variant-button" for="{{ input_id }}">{{ value.name }}</label>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endif -%}
    {%- endfor -%}

    <noscript>
      <div class="kf-field">
        <label class="kf-field__label" for="{{ form_id }}-variants">
          {{ 'products.product.choose_variant' | t }}
        </label>
        <select class="kf-select" id="{{ form_id }}-variants" name="id" form="{{ form_id }}">
          {%- for variant in target.variants -%}
            <option
              value="{{ variant.id }}"
              {% if variant == target.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }}
              {%- unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
              — {{ variant.price | money }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </noscript>
  </kf-variant-picker>
{%- endif -%}

{% schema %}
{
  "name": "Variant picker",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "buttons", "label": "Buttons" },
        { "value": "swatches", "label": "Swatches" },
        { "value": "dropdown", "label": "Dropdowns" }
      ],
      "default": "auto",
      "info": "Automatic uses swatches for options that have them in your product settings, and buttons for the rest."
    },
    {
      "type": "checkbox",
      "id": "show_selected_value",
      "label": "Show the selected value beside the option name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "Update the page address when a variant is chosen",
      "default": true,
      "info": "Lets shoppers share or bookmark a link to a specific variant."
    }
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
