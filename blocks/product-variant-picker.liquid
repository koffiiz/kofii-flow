{%- comment -%}
  Kofii Flow — Variant picker block
  ---------------------------------------------------------------------------
  A thin wrapper over `snippets/kf-variant-picker.liquid`, which is also
  rendered by the quick add panel. The markup lives in the snippet so the two
  can never drift apart.

  `scope: 'Product'` keeps this picker's input ids distinct from a quick add
  panel that may be open in the same document.
{%- endcomment -%}

{%- liquid
  assign target = closest.product
  assign form_id = 'KfProductForm-' | append: target.id
-%}

{%- if target != blank -%}
  <div {{ block.shopify_attributes }}>
    {%- render 'kf-variant-picker',
      product: target,
      form_id: form_id,
      scope: 'Product',
      style: block.settings.style,
      show_selected_value: block.settings.show_selected_value,
      update_url: block.settings.update_url
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Variant picker",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "buttons", "label": "Buttons" },
        { "value": "swatches", "label": "Swatches" },
        { "value": "dropdown", "label": "Dropdowns" }
      ],
      "default": "auto",
      "info": "Automatic uses swatches for options that have them in your product settings, and buttons for the rest."
    },
    {
      "type": "checkbox",
      "id": "show_selected_value",
      "label": "Show the selected value beside the option name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "Update the page address when a variant is chosen",
      "default": true,
      "info": "Lets shoppers share or bookmark a link to a specific variant."
    }
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
