{%- comment -%}
  Kofii Flow — Variant picker block
  ---------------------------------------------------------------------------
  A thin wrapper over `snippets/kf-variant-picker.liquid`, which is also
  rendered by the quick add panel. The markup lives in the snippet so the two
  can never drift apart.

  `scope: 'Product'` keeps this picker's input ids distinct from a quick add
  panel that may be open in the same document.
{%- endcomment -%}

{%- liquid
  assign target = closest.product
  assign form_id = 'KfProductForm-' | append: target.id
-%}

{%- if target != blank -%}
  <div {{ block.shopify_attributes }}>
    {%- render 'kf-variant-picker',
      product: target,
      form_id: form_id,
      scope: 'Product',
      style: block.settings.style,
      show_selected_value: block.settings.show_selected_value,
      update_url: block.settings.update_url
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product-variant-picker.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.product-variant-picker.settings.style.label",
      "options": [
        {
          "value": "auto",
          "label": "t:blocks.product-variant-picker.settings.style.options__1.label"
        },
        {
          "value": "buttons",
          "label": "t:blocks.product-variant-picker.settings.style.options__2.label"
        },
        {
          "value": "swatches",
          "label": "t:blocks.product-variant-picker.settings.style.options__3.label"
        },
        {
          "value": "dropdown",
          "label": "t:blocks.product-variant-picker.settings.style.options__4.label"
        }
      ],
      "default": "auto",
      "info": "t:blocks.product-variant-picker.settings.style.info"
    },
    {
      "type": "checkbox",
      "id": "show_selected_value",
      "label": "t:blocks.product-variant-picker.settings.show_selected_value.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "t:blocks.product-variant-picker.settings.update_url.label",
      "default": true,
      "info": "t:blocks.product-variant-picker.settings.update_url.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-variant-picker.presets.name"
    }
  ]
}
{% endschema %}
