{%- comment -%}
  Kofii Flow — Badge block
  A small label: an eyebrow above a heading, a "New in" pill, a trust marker.
{%- endcomment -%}

{%- if block.settings.text != blank -%}
  <div
    class="kf-block-badge"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    <span class="kf-badge kf-badge--{{ block.settings.style }}">
      {%- if block.settings.icon != 'none' -%}
        {%- render 'kf-icon', name: block.settings.icon, size: 'sm' -%}
      {%- endif -%}
      {{ block.settings.text | escape }}
    </span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.badge.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.badge.settings.text.label",
      "default": "New this season"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.badge.settings.style.label",
      "options": [
        {
          "value": "muted",
          "label": "t:blocks.badge.settings.style.options__1.label"
        },
        {
          "value": "outline",
          "label": "t:blocks.badge.settings.style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:blocks.badge.settings.style.options__3.label"
        },
        {
          "value": "accent",
          "label": "t:blocks.badge.settings.style.options__4.label"
        }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.badge.settings.icon.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.badge.settings.icon.options__1.label"
        },
        {
          "value": "star",
          "label": "t:blocks.badge.settings.icon.options__2.label"
        },
        {
          "value": "check",
          "label": "t:blocks.badge.settings.icon.options__3.label"
        },
        {
          "value": "arrow",
          "label": "t:blocks.badge.settings.icon.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:blocks.badge.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.badge.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.badge.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.badge.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.badge.settings.animation.options__3.label"
        },
        {
          "value": "scale-up",
          "label": "t:blocks.badge.settings.animation.options__4.label"
        },
        {
          "value": "blur-in",
          "label": "t:blocks.badge.settings.animation.options__5.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.badge.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.badge.presets.name"
    }
  ]
}
{% endschema %}
