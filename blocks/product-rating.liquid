{%- comment -%}
  Kofii Flow — Product rating block
  ---------------------------------------------------------------------------
  Reads the standard `reviews.rating` and `reviews.rating_count` metafields,
  which most review apps write to. No app-specific code, no hardcoded widget.

  Renders nothing when there is no rating yet — an empty five-star row implies
  a zero score, which is worse than showing nothing.
{%- endcomment -%}

{%- liquid
  assign target = closest.product
  assign rating = target.metafields.reviews.rating.value
  assign rating_count = target.metafields.reviews.rating_count.value
-%}

{%- if rating.rating != blank and rating_count > 0 -%}
  <div class="kf-product__rating kf-cluster" {{ block.shopify_attributes }}>
    {%- render 'kf-stars', rating: rating.rating, scale_max: rating.scale_max -%}

    {%- if block.settings.show_value -%}
      <span class="kf-text-sm">{{ rating.rating }}</span>
    {%- endif -%}

    {%- if block.settings.show_count -%}
      <span class="kf-text-sm kf-text-muted">
        {{- 'products.product.rating_count' | t: count: rating_count -}}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product-rating.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.product-rating.settings.paragraph__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_value",
      "label": "t:blocks.product-rating.settings.show_value.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:blocks.product-rating.settings.show_count.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-rating.presets.name"
    }
  ]
}
{% endschema %}
