{%- comment -%}
  Kofii Flow — Text block
  Rich text with a curated size scale. Uses .kf-rte so links, lists and
  blockquotes inherit the theme typography.
{%- endcomment -%}

{%- liquid
  assign classes = 'kf-block-text kf-rte'
  case block.settings.text_size
    when 'sm'
      assign classes = classes | append: ' kf-text-sm'
    when 'lg'
      assign classes = classes | append: ' kf-text-lg'
    when 'xl'
      assign classes = classes | append: ' kf-text-xl'
  endcase
  if block.settings.text_muted
    assign classes = classes | append: ' kf-text-muted'
  endif
  if block.settings.text_width == 'narrow'
    assign classes = classes | append: ' kf-w-narrow'
  endif
-%}

{%- if block.settings.text != blank -%}
  <div
    class="{{ classes }}"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.settings.text.label",
      "default": "<p>Say the one thing a visitor needs to know before they scroll.</p>"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:blocks.text.settings.text_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:blocks.text.settings.text_size.options__1.label"
        },
        {
          "value": "md",
          "label": "t:blocks.text.settings.text_size.options__2.label"
        },
        {
          "value": "lg",
          "label": "t:blocks.text.settings.text_size.options__3.label"
        },
        {
          "value": "xl",
          "label": "t:blocks.text.settings.text_size.options__4.label"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "text_width",
      "label": "t:blocks.text.settings.text_width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:blocks.text.settings.text_width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:blocks.text.settings.text_width.options__2.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "text_muted",
      "label": "t:blocks.text.settings.text_muted.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:blocks.text.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.text.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.text.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.text.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.text.settings.animation.options__3.label"
        },
        {
          "value": "fade-down",
          "label": "t:blocks.text.settings.animation.options__4.label"
        },
        {
          "value": "fade-left",
          "label": "t:blocks.text.settings.animation.options__5.label"
        },
        {
          "value": "fade-right",
          "label": "t:blocks.text.settings.animation.options__6.label"
        },
        {
          "value": "scale-up",
          "label": "t:blocks.text.settings.animation.options__7.label"
        },
        {
          "value": "blur-in",
          "label": "t:blocks.text.settings.animation.options__8.label"
        },
        {
          "value": "clip-up",
          "label": "t:blocks.text.settings.animation.options__9.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.text.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.text.presets.name"
    }
  ]
}
{% endschema %}
