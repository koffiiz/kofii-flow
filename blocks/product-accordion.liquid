{%- comment -%}
  Kofii Flow — Accordion block
  ---------------------------------------------------------------------------
  Collapsible rows for shipping, care, sizing and similar. Built on native
  <details>, enhanced by <kf-accordion> for the open/close animation and the
  optional one-at-a-time behaviour.

  Not product-specific despite the file name grouping — it works anywhere
  theme blocks are accepted.
{%- endcomment -%}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- if block.blocks.size > 0 -%}
  <kf-accordion
    class="kf-product__accordion"
    data-single="{{ block.settings.single }}"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </kf-accordion>
{%- endif -%}


{% schema %}
{
  "name": "t:blocks.product-accordion.name",
  "tag": null,
  "blocks": [
    {
      "type": "_accordion-item"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "single",
      "label": "t:blocks.product-accordion.settings.single.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:blocks.product-accordion.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.product-accordion.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.product-accordion.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.product-accordion.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.product-accordion.settings.animation.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.product-accordion.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-accordion.presets.name",
      "blocks": [
        {
          "type": "_accordion-item"
        },
        {
          "type": "_accordion-item"
        }
      ]
    }
  ]
}
{% endschema %}
