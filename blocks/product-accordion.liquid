{%- comment -%}
  Kofii Flow — Accordion block
  ---------------------------------------------------------------------------
  Collapsible rows for shipping, care, sizing and similar. Built on native
  <details>, enhanced by <kf-accordion> for the open/close animation and the
  optional one-at-a-time behaviour.

  Not product-specific despite the file name grouping — it works anywhere
  theme blocks are accepted.
{%- endcomment -%}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- if block.blocks.size > 0 -%}
  <kf-accordion
    class="kf-product__accordion"
    data-single="{{ block.settings.single }}"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </kf-accordion>
{%- endif -%}


{% schema %}
{
  "name": "Accordion",
  "tag": null,
  "blocks": [{ "type": "_accordion-item" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "single",
      "label": "Open one row at a time",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Accordion",
      "blocks": [
        { "type": "_accordion-item" },
        { "type": "_accordion-item" }
      ]
    }
  ]
}
{% endschema %}
