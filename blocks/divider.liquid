{%- comment -%}
  Kofii Flow — Divider block
  A hairline rule. Decorative, so it is hidden from assistive technology.
{%- endcomment -%}

{%- liquid
  assign classes = 'kf-block-divider'
  if block.settings.width == 'narrow'
    assign classes = classes | append: ' kf-block-divider--narrow'
  endif
  if block.settings.style == 'accent'
    assign classes = classes | append: ' kf-block-divider--accent'
  endif
-%}

<div
  class="{{ classes }}"
  style="--kf-divider-thickness: {{ block.settings.thickness }}px;"
  role="presentation"
  {% render 'kf-motion-attrs', motion: block.settings %}
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:blocks.divider.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.divider.settings.width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:blocks.divider.settings.width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:blocks.divider.settings.width.options__2.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "t:blocks.divider.settings.thickness.label",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.divider.settings.style.label",
      "options": [
        {
          "value": "border",
          "label": "t:blocks.divider.settings.style.options__1.label"
        },
        {
          "value": "accent",
          "label": "t:blocks.divider.settings.style.options__2.label"
        }
      ],
      "default": "border"
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.divider.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.divider.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.divider.settings.animation.options__2.label"
        },
        {
          "value": "clip-right",
          "label": "t:blocks.divider.settings.animation.options__3.label"
        },
        {
          "value": "clip-left",
          "label": "t:blocks.divider.settings.animation.options__4.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.divider.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.divider.presets.name"
    }
  ]
}
{% endschema %}
