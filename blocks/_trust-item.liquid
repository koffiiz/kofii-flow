{%- comment -%}
  Kofii Flow — Trust item
  ---------------------------------------------------------------------------
  A private theme block (leading underscore): it only appears inside blocks
  that explicitly allow it, so it never clutters the general block picker.
  Used by blocks/trust-row.liquid.
{%- endcomment -%}

{%- if block.settings.text != blank -%}
  <li class="kf-trust__item" {{ block.shopify_attributes }}>
    {%- if block.settings.icon != 'none' -%}
      {%- render 'kf-icon', name: block.settings.icon, class: 'kf-trust__icon', size: 'sm' -%}
    {%- endif -%}
    <span>{{ block.settings.text | escape }}</span>
  </li>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks._trust-item.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks._trust-item.settings.text.label",
      "default": "Free returns within 30 days"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks._trust-item.settings.icon.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks._trust-item.settings.icon.options__1.label"
        },
        {
          "value": "check",
          "label": "t:blocks._trust-item.settings.icon.options__2.label"
        },
        {
          "value": "star",
          "label": "t:blocks._trust-item.settings.icon.options__3.label"
        },
        {
          "value": "globe",
          "label": "t:blocks._trust-item.settings.icon.options__4.label"
        },
        {
          "value": "arrow",
          "label": "t:blocks._trust-item.settings.icon.options__5.label"
        }
      ],
      "default": "check"
    }
  ]
}
{% endschema %}
