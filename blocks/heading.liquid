{%- comment -%}
  Kofii Flow — Heading block
  ---------------------------------------------------------------------------
  A theme block, available to any section that declares {"type": "@theme"}.

  The heading level and the visual size are separate settings on purpose:
  a section can look like a display heading while staying an <h2>, so the
  document outline remains correct. There should be one <h1> per page.
{%- endcomment -%}

{%- liquid
  assign tag = block.settings.heading_tag | default: 'h2'
  assign size_class = block.settings.heading_size | default: 'kf-h2'
  assign classes = 'kf-block-heading ' | append: size_class
  if block.settings.heading_accent
    assign classes = classes | append: ' kf-text-accent'
  endif
-%}

{%- if block.settings.heading != blank -%}
  <{{ tag }}
    class="{{ classes }}"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {{- block.settings.heading -}}
  </{{ tag }}>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.heading.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:blocks.heading.settings.heading.label",
      "default": "A heading that carries the page"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:blocks.heading.settings.heading_size.label",
      "options": [
        {
          "value": "kf-h4",
          "label": "t:blocks.heading.settings.heading_size.options__1.label"
        },
        {
          "value": "kf-h3",
          "label": "t:blocks.heading.settings.heading_size.options__2.label"
        },
        {
          "value": "kf-h2",
          "label": "t:blocks.heading.settings.heading_size.options__3.label"
        },
        {
          "value": "kf-h1",
          "label": "t:blocks.heading.settings.heading_size.options__4.label"
        },
        {
          "value": "kf-display-sm",
          "label": "t:blocks.heading.settings.heading_size.options__5.label"
        },
        {
          "value": "kf-display-md",
          "label": "t:blocks.heading.settings.heading_size.options__6.label"
        },
        {
          "value": "kf-display-lg",
          "label": "t:blocks.heading.settings.heading_size.options__7.label"
        }
      ],
      "default": "kf-h2"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:blocks.heading.settings.heading_tag.label",
      "info": "t:blocks.heading.settings.heading_tag.info",
      "options": [
        {
          "value": "h1",
          "label": "t:blocks.heading.settings.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:blocks.heading.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:blocks.heading.settings.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:blocks.heading.settings.heading_tag.options__4.label"
        },
        {
          "value": "p",
          "label": "t:blocks.heading.settings.heading_tag.options__5.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "heading_accent",
      "label": "t:blocks.heading.settings.heading_accent.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.heading.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.heading.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.heading.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.heading.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.heading.settings.animation.options__3.label"
        },
        {
          "value": "fade-down",
          "label": "t:blocks.heading.settings.animation.options__4.label"
        },
        {
          "value": "fade-left",
          "label": "t:blocks.heading.settings.animation.options__5.label"
        },
        {
          "value": "fade-right",
          "label": "t:blocks.heading.settings.animation.options__6.label"
        },
        {
          "value": "scale-up",
          "label": "t:blocks.heading.settings.animation.options__7.label"
        },
        {
          "value": "blur-in",
          "label": "t:blocks.heading.settings.animation.options__8.label"
        },
        {
          "value": "clip-up",
          "label": "t:blocks.heading.settings.animation.options__9.label"
        },
        {
          "value": "reveal",
          "label": "t:blocks.heading.settings.animation.options__10.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.heading.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.heading.presets.name"
    }
  ]
}
{% endschema %}
