{%- comment -%}
  Kofii Flow — Button block
  Renders through snippets/kf-button.liquid so every button in the theme
  shares one implementation and one set of hover microinteractions.

  Supports two buttons in one block, which is the common hero pattern
  (primary action plus a quieter secondary action).
{%- endcomment -%}

{%- liquid
  assign has_primary = false
  if block.settings.label != blank
    assign has_primary = true
  endif

  assign has_secondary = false
  if block.settings.secondary_label != blank
    assign has_secondary = true
  endif

  assign group_class = 'kf-button-group kf-button-group--stack-mobile'
-%}

{%- if has_primary or has_secondary -%}
  <div
    class="{{ group_class }}"
    {% render 'kf-motion-attrs', motion: block.settings %}
    {{ block.shopify_attributes }}
  >
    {%- if has_primary -%}
      {%- render 'kf-button',
        label: block.settings.label,
        href: block.settings.link,
        style: block.settings.style,
        size: block.settings.size,
        new_tab: block.settings.new_tab
      -%}
    {%- endif -%}

    {%- if has_secondary -%}
      {%- render 'kf-button',
        label: block.settings.secondary_label,
        href: block.settings.secondary_link,
        style: block.settings.secondary_style,
        size: block.settings.size,
        new_tab: block.settings.new_tab
      -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.button.settings.label.label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.button.settings.style.label",
      "options": [
        {
          "value": "primary",
          "label": "t:blocks.button.settings.style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:blocks.button.settings.style.options__2.label"
        },
        {
          "value": "ghost",
          "label": "t:blocks.button.settings.style.options__3.label"
        },
        {
          "value": "plain",
          "label": "t:blocks.button.settings.style.options__4.label"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:blocks.button.settings.secondary_label.label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:blocks.button.settings.secondary_link.label"
    },
    {
      "type": "select",
      "id": "secondary_style",
      "label": "t:blocks.button.settings.secondary_style.label",
      "options": [
        {
          "value": "primary",
          "label": "t:blocks.button.settings.secondary_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:blocks.button.settings.secondary_style.options__2.label"
        },
        {
          "value": "ghost",
          "label": "t:blocks.button.settings.secondary_style.options__3.label"
        },
        {
          "value": "plain",
          "label": "t:blocks.button.settings.secondary_style.options__4.label"
        }
      ],
      "default": "plain"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:blocks.button.settings.size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:blocks.button.settings.size.options__1.label"
        },
        {
          "value": "md",
          "label": "t:blocks.button.settings.size.options__2.label"
        },
        {
          "value": "lg",
          "label": "t:blocks.button.settings.size.options__3.label"
        }
      ],
      "default": "md"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "t:blocks.button.settings.new_tab.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:blocks.button.settings.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.button.settings.animation.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.button.settings.animation.options__2.label"
        },
        {
          "value": "fade-up",
          "label": "t:blocks.button.settings.animation.options__3.label"
        },
        {
          "value": "scale-up",
          "label": "t:blocks.button.settings.animation.options__4.label"
        },
        {
          "value": "blur-in",
          "label": "t:blocks.button.settings.animation.options__5.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:blocks.button.settings.animation_delay.label",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.button.presets.name"
    }
  ]
}
{% endschema %}
